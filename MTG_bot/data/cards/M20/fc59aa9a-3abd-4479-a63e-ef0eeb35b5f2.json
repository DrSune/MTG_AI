  "draft_py": "# Sage's Row Denizen: \"Whenever another blue creature you control enters, target player mills two cards.\"\n# Event: Watcher of the Spheres' \"another creature you control with flying enters\" shape with COLOR_HAS U\n# in place of the flying test. Effect: Teferi's Tutelage's \"target opponent mills two cards\" with\n# TARGET_PLAYER (\"target player\": any player, V21).\nevent = ZoneChangeEvent(\n    from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n    to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n    subject=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        FAtom(pred=FAtomPred.COLOR_HAS, color='U'),\n        FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n    )),\n)\nmill = A(Verb.MOVE_ZONE, {\n    'amount': QConst(value=2),\n    'controller': ControllerRef.TARGET_PLAYER,\n    'destination': Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.TARGET_PLAYER),\n    'from': Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.TARGET_PLAYER),\n    'journal_kind': 'MILL',\n    'pop_order': 'TOP',\n})\nabilities = [TriggeredAbility(event=event, condition=None, effect=mill), *compiled]\n",
  "clauses": [
   {
    "clause": "Whenever another blue creature you control enters, target player mills two cards.",
    "ir": "abilities[0]"
   }
  ],

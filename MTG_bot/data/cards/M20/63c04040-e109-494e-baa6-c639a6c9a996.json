  "draft_py": "# Bag of Holding (M20)\n# Whenever you discard a card, exile that card from your graveyard.\n# {2}, {T}: Draw a card, then discard a card.                       (compiled[0])\n# {4}, {T}, Sacrifice this artifact: Return all cards exiled with this artifact to their owner's hand.\n\n# In this engine every discard (effect, cost, cleanup) is the hand->graveyard MOVE_ZONE, so\n# \"you discard a card\" is a zone change from your hand to your graveyard, one firing per card.\ndiscard_trigger = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n        to_zone=Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),\n    ),\n    condition=None,\n    effect=A(Verb.MOVE_ZONE, {\n        'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAnd(children=()),\n            zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n            referent='event',\n        ),\n    }),\n)\n\nreturn_all = ActivatedAbility(\n    cost=Cost(\n        parts=(\n            CostManaGeneric(amount=QConst(value=4)),\n            CostSacrifice(\n                target=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(\n                        children=(\n                            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                            FAtom(pred=FAtomPred.IS_SOURCE),\n                        ),\n                    ),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            ),\n            CostTap(),\n        ),\n    ),\n    effect=A(Verb.MOVE_ZONE, {\n        'cards': Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAtom(pred=FAtomPred.IS_EXILED_WITH_SOURCE),\n            zones=(Zone(kind=ZoneKind.EXILE, controller=ControllerRef.ANY),),\n        ),\n        'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.OWNER),\n    }),\n)\n\n# 'all cards exiled with this artifact', whoever owns them: every exile zone, narrowed by the\n# IS_EXILED_WITH_SOURCE link.\nabilities = [discard_trigger, compiled[0], return_all, compiled[1]]\n",
  "clauses": [

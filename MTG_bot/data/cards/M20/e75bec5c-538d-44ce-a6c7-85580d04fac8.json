  "draft_py": "# Chandra's Embercat: \"{T}: Add {R}. Spend this mana only to cast an Elemental spell or a Chandra\n# planeswalker spell.\"  Vodalian Arcanist's layout: the compiled mana ability, then a THIS_MANA\n# MANA_POLICY static. \"an Elemental spell\" is a bare SUBTYPE_EQ (Windrider Wizard's \"Wizard\n# spell\"); \"a Chandra planeswalker\" is Keral Keep Disciples' SUBTYPE_EQ Chandra + TYPE_EQ\n# Planeswalker.\npolicy = StaticAbility(\n    effect=A(Verb.MANA_POLICY, {\n        'filter': FOr(\n            children=(\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n                FAnd(\n                    children=(\n                        FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Chandra'),\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                    ),\n                ),\n            ),\n        ),\n        'scope': 'THIS_MANA',\n    }),\n)\nabilities = [compiled[0], policy, compiled[1]]\n",
  "clauses": [
   {

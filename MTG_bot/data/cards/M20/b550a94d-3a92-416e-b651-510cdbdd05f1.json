  "draft_py": "# Retributive Wand\nany_target = lambda: Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FOr(children=(\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Player'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\n# 1. \"{3}, {T}: This artifact deals 1 damage to any target.\" -- Chandra's Magmutt's activated\n#    DEAL_DAMAGE shape (B3-deal-dmg-const-player-or-planeswalker) with a {3} cost and Shock's\n#    \"any target\" selector (B5b-damage-any).\nping = ActivatedAbility(\n    cost=Cost(parts=(CostManaGeneric(amount=QConst(value=3)), CostTap())),\n    effect=A(Verb.DEAL_DAMAGE, {'amount': QConst(value=1), 'target': any_target()}),\n)\n# 2. \"When this artifact is put into a graveyard from the battlefield, it deals 5 damage to any\n#    target.\" -- Pitchburn Devils' \"When this creature dies, it deals 3 damage to any target\"\n#    (B2a-pitchburn-devils) with the zone change written out for a noncreature permanent:\n#    battlefield -> any graveyard, subject this object.\ndies = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.ANY),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.DEAL_DAMAGE, {'amount': QConst(value=5), 'target': any_target()}),\n)\nabilities = [ping, dies, *compiled]\n",

  "draft_py": "# Bladebrand: \"Target creature gains deathtouch until end of turn. / Draw a card.\"\ngrant = A(Verb.GRANT_ABILITY, {\n    'ability': KeywordAbility(keyword=Keyword.DEATHTOUCH),\n    'duration': DurationEot(),\n    'target': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.TARGET,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n})\ndraw = A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU})\nabilities = [SpellAbility(kind=SpellKind.INSTANT, effect=Seq(steps=(grant, draw)))]\n",

  "draft_py": "# Scampering Scorcher (M20): \"When this creature enters, create two 1/1 red Elemental creature tokens.\n#   Elementals you control gain haste until end of turn.\"\n# Both sentences are the one ETB trigger's effect: Seq(compiled CREATE_TOKEN, GRANT_ABILITY).\n# Grant shape: B4-grant-trample-eot-you (\"Creatures you control gain trample until end of turn.\") with\n# haste, and the tribal noun \"Elementals\" = SUBTYPE_EQ Elemental + TYPE_EQ Creature (guide; B5c-zombies-pt).\netb = compiled[0]\nelementals_haste = A(Verb.GRANT_ABILITY, {\n    'ability': KeywordAbility(keyword=Keyword.HASTE),\n    'duration': DurationEot(),\n    'target': Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(\n            children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            ),\n        ),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n})\netb_full = TriggeredAbility(\n    event=etb.event,\n    condition=etb.condition,\n    effect=Seq(steps=(etb.effect, elementals_haste)),\n)\nabilities = [etb_full, compiled[1]]\n",
  "clauses": [
   {
    "clause": "When this creature enters, create two 1/1 red Elemental creature tokens.",
    "ir": "abilities[0] (event; effect.steps[0])"
   },
   {
    "clause": "Elementals you control gain haste until end of turn.",
    "ir": "abilities[0].effect.steps[1]"
   }
  ],

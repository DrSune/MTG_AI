  "draft_py": "# Brightwood Tracker (M20)\n# {5}{G}, {T}: Look at the top four cards of your library. You may reveal a creature card from\n# among them and put it into your hand. Put the rest on the bottom of your library in a random order.\n\n_top_of_library = (Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU, position=ZonePosition.TOP),)\n\ntracker = ActivatedAbility(\n    cost=Cost(\n        parts=(\n            CostManaColor(color='G', amount=QConst(value=1)),\n            CostManaGeneric(amount=QConst(value=5)),\n            CostTap(),\n        ),\n    ),\n    effect=Seq(\n        steps=(\n            A(Verb.LOOK_AT, {'controller': ControllerRef.YOU, 'count': QConst(value=4)}),\n            OptionalEffect(\n                inner=Seq(\n                    steps=(\n                        A(Verb.REVEAL, {'controller': ControllerRef.YOU, 'count': QConst(value=1)}),\n                        A(Verb.MOVE_ZONE, {\n                            'cards': Selector(\n                                count=QConst(value=1),\n                                mode=SelectorMode.ONE_OF,\n                                filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                                zones=_top_of_library,\n                            ),\n                            'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n                        }),\n                    ),\n                ),\n            ),\n            A(Verb.MOVE_ZONE, {\n                'cards': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.REST,\n                    filter=FAnd(children=()),\n                    zones=_top_of_library,\n                ),\n                'destination': Zone(\n                    kind=ZoneKind.LIBRARY,\n                    controller=ControllerRef.YOU,\n                    position=ZonePosition.BOTTOM,\n                ),\n            }),\n        ),\n    ),\n)\n\nabilities = [tracker, *compiled]\n",

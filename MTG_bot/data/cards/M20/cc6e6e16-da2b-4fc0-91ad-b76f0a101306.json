  "draft_py": "# M20 Masterful Replication (copy round B3, DESIGN_ATOM_ONTOLOGY §18)\n_bf = Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY)\n_artifact_you = FAnd(children=(\n    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Artifact'),\n    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n))\ngolems = A(Verb.CREATE_TOKEN, {\n    'count': QConst(value=2),\n    'tokens': TokenSpec(\n        name='Golem', type_line='Artifact Creature — Golem', types=('Artifact', 'Creature'),\n        subtypes=('Golem',), power=QConst(value=3), toughness=QConst(value=3), keywords=(),\n        abilities=(),\n    ),\n})\n# \"Choose target artifact you control. Each other artifact you control becomes a copy of that\n# artifact until end of turn.\": the target is the copy's source (the one designation, T1), the\n# other artifacts you control the permanents that become copies, until end of turn.\nbecome = A(Verb.COPY, {\n    'duration': DurationEot(),\n    'source': CopyOf(source=Selector(count=QConst(value=1), mode=SelectorMode.TARGET,\n                                     filter=_artifact_you, zones=(_bf,))),\n    'cards': Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(children=(_artifact_you, FNot(inner=FAtom(pred=FAtomPred.IS_ANY_TARGET)))),\n        zones=(_bf,),\n    ),\n})\nabilities = [SpellAbility(kind=SpellKind.INSTANT, effect=Choose(count=QConst(value=1), options=(golems, become)))]\n",
  "clauses": [

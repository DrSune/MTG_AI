  "draft_py": "# M20 Fry\n# \"This spell can't be countered.\" is the compiler's (B14). \"Fry deals 5 damage to target creature\n# or planeswalker that's white or blue.\": `parse \"~ deals 5 damage to target creature or\n# planeswalker.\" --name Fry` (B5b-named-damage), with the colour restriction added to the target\n# filter as an FOr of COLOR_HAS (MAPPER_GUIDE: \"Green or white\" is an FOr of COLOR_HAS; Quirion\n# Dryad's \"a spell that's white, blue, black, or red\").\nspell = SpellAbility(\n    kind=SpellKind.INSTANT,\n    effect=A(Verb.DEAL_DAMAGE, {\n        'amount': QConst(value=5),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAnd(\n                children=(\n                    FOr(\n                        children=(\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                        ),\n                    ),\n                    FOr(\n                        children=(\n                            FAtom(pred=FAtomPred.COLOR_HAS, color='W'),\n                            FAtom(pred=FAtomPred.COLOR_HAS, color='U'),\n                        ),\n                    ),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [*compiled, spell]\n",

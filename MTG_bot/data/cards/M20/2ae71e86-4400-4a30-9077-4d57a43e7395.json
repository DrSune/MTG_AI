  "draft_py": "# Risen Reef\n# s1: Whenever this creature or another Elemental you control enters, look at the\n#     top card of your library.\n# s2: If it's a land card, you may put it onto the battlefield tapped.\n# s3: If you don't put the card onto the battlefield, put it into your hand.\ndef _it():\n    return Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAnd(children=()),\n        zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n        referent='result',\n    )\n\ndef _to_hand():\n    return A(Verb.MOVE_ZONE, {\n        'cards': _it(),\n        'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n    })\n\ntrig = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FOr(children=(\n            FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n            )),\n            FAtom(pred=FAtomPred.IS_SOURCE),\n        )),\n    ),\n    condition=None,\n    effect=Seq(steps=(\n        A(Verb.LOOK_AT, {'controller': ControllerRef.YOU, 'count': QConst(value=1)}),\n        Conditional(\n            pred=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n            then_effect=Seq(steps=(\n                OptionalEffect(inner=A(Verb.MOVE_ZONE, {\n                    'cards': _it(),\n                    'destination': Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n                    'tapped_on_enter': True,\n                })),\n                Conditional(\n                    pred=FNot(inner=FAtom(pred=FAtomPred.MAY_DONE)),\n                    then_effect=_to_hand(),\n                ),\n            )),\n            else_effect=_to_hand(),\n        ),\n    )),\n)\nabilities = [trig, *compiled]\n",

 "mapping": {
  "author": "claude-mapper-m20-8",
  "date": "2026-11-05",
  "draft_py": "# Growth Cycle (M20) instant.\n# s1 (compiled, B5b-modpt-plus): Target creature gets +3/+3 until end of turn.\n# s2: It gets an additional +2/+2 until end of turn for each card named Growth Cycle in your graveyard.\n#   \"It\" = the spell's target: a referent='target' selector (Strength of Solidarity's \"Put a +1/+1 counter on it\n#   for each ...\" and Invigorating Surge's \"that creature\").\n#   \"+2/+2 ... for each X\": QBin(MUL, QConst(2), <count>) (Grotag Bug-Catcher / Shepherd of Heroes \"N for each\").\n#   \"cards named Growth Cycle in your graveyard\": Frantic Inventory's QCount(ALL, NAME_EQ, GRAVEYARD YOU).\n#   Two sentences, one spell: the SpellAbility effect is Seq(s1, s2) in printed order.\nfirst = compiled[0].effect\nper_copy = QBin(\n    op=QBinOp.MUL,\n    left=QConst(value=2),\n    right=QCount(\n        selector=Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAtom(pred=FAtomPred.NAME_EQ, string_value='Growth Cycle'),\n            zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),),\n        ),\n    ),\n)\nadditional = A(Verb.MODIFY_PT, {\n    'duration': DurationEot(),\n    'power': PtDelta(direction=PtDirection.INCREASE, magnitude=per_copy),\n    'target': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n        referent='target',\n    ),\n    'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=per_copy),\n})\nabilities = [SpellAbility(kind=SpellKind.INSTANT, effect=Seq(steps=(first, additional)))]\n",
  "clauses": [

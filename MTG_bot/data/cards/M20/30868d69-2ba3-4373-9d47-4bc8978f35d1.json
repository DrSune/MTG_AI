  "date": "2026-11-05",
  "draft_py": "# Yarok's Wavecrasher: \"When this creature enters, return another creature you control to its\n# owner's hand.\"  Not targeted, not optional: the controller chooses one other creature they control\n# (Dire Fleet Warmonger's CHOOSE shape) and returns it (Niambi's MOVE_ZONE shape).\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.MOVE_ZONE, {\n        'cards': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.OWNER),\n    }),\n)\nabilities = [etb, *compiled]\n",
  "clauses": [
   {
    "clause": "When this creature enters, return another creature you control to its owner's hand.",
    "ir": "abilities[0]"
   }

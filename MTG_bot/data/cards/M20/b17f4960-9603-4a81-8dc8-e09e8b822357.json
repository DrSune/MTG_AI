 "mapping": {
  "author": "claude-mapper-m20-1",
  "date": "2026-11-05",
  "draft_py": "# Noxious Grasp: \"Destroy target creature or planeswalker that's green or white. You gain 1 life.\"\n# Finishing Blow's DESTROY (creature or planeswalker) narrowed by \"that's green or white\", an FOr\n# of COLOR_HAS (guide: never COLOR_IN; Quirion Dryad's colour shape). Then the compiled gain-1.\nspell = compiled[0]\ndestroy = A(Verb.DESTROY, {\n    'target': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.TARGET,\n        filter=FAnd(\n            children=(\n                FOr(\n                    children=(\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                    ),\n                ),\n                FOr(\n                    children=(\n                        FAtom(pred=FAtomPred.COLOR_HAS, color='G'),\n                        FAtom(pred=FAtomPred.COLOR_HAS, color='W'),\n                    ),\n                ),\n            ),\n        ),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n})\nabilities = [SpellAbility(kind=SpellKind.INSTANT, effect=Seq(steps=(destroy, spell.effect)))]\n",
  "clauses": [
   {
    "clause": "Destroy target creature or planeswalker that's green or white.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "You gain 1 life.",
    "ir": "abilities[0].effect.steps[1]"
   }
  ],

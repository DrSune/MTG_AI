  "draft_py": "# M20 Wakeroot Elemental {4}{G}{G} 5/5\n# \"{G}{G}{G}{G}{G}: Untap target land you control. It becomes a 5/5 Elemental creature with haste.\n#  It's still a land. (This effect lasts as long as that land remains on the battlefield.)\"\n# The compiled activated ability (cost and UNTAP of target land you control) is kept; its effect\n# gains M21 Riddleform's become-a-creature steps (SET_PT, GRANT_TYPE adding 'Creature' and the\n# subtype, so it stays a land, GRANT_ABILITY haste) aimed at \"it\" = the ability's target\n# (referent 'target', as Alchemist's Gift). No duration role: the effect is indefinite, and it ends\n# when that land leaves the battlefield (CR 400.7; the engine drops it since fix/w2-effects).\nact = compiled[0]\nit = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.CHOOSE,\n    filter=FAnd(children=()),\n    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n    referent='target',\n)\nabilities = [\n    ActivatedAbility(\n        cost=act.cost,\n        effect=Seq(\n            steps=(\n                act.effect,\n                A(Verb.SET_PT, {'power': QConst(value=5), 'target': it, 'toughness': QConst(value=5)}),\n                A(Verb.GRANT_TYPE, {'target': it, 'types': ('Creature', 'Elemental')}),\n                A(Verb.GRANT_ABILITY, {'ability': KeywordAbility(keyword=Keyword.HASTE), 'target': it}),\n            ),\n        ),\n    ),\n    compiled[1],\n]\n",
  "clauses": [
   {
    "clause": "{G}{G}{G}{G}{G}: Untap target land you control.",
    "ir": "abilities[0].cost, abilities[0].effect.steps[0]"
   },

  "author": "claude-mapper-m20-7",
  "date": "2026-11-05",
  "draft_py": "# Blood for Bones (M20).\n# s1 (compiled, kept): \"As an additional cost to cast this spell, sacrifice a creature.\"\n# s2: \"Return a creature card from your graveyard to the battlefield, then return another creature\n#      card from your graveyard to your hand.\"\n# Two non-targeted returns in printed order: Experimental Overload's CHOOSE-from-your-graveyard\n# MOVE_ZONE (B5c-then-return-is) with Rise Again's creature filter and battlefield destination\n# (B5b-return-creatures-battlefield), then the same CHOOSE to your hand. \"another\" holds by\n# construction: the first card has left the graveyard before the second choice.\nbase = compiled[0]\nto_battlefield = A(Verb.MOVE_ZONE, {\n    'cards': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),),\n    ),\n    'destination': Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),\n})\nto_hand = A(Verb.MOVE_ZONE, {\n    'cards': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),),\n    ),\n    'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n})\nabilities = [\n    SpellAbility(\n        kind=base.kind,\n        effect=Seq(steps=(to_battlefield, to_hand)),\n        additional_costs=base.additional_costs,\n    ),\n]\n",
  "clauses": [
   {
    "clause": "As an additional cost to cast this spell, sacrifice a creature.",
    "ir": "abilities[0].additional_costs[0]"
   },
   {
    "clause": "Return a creature card from your graveyard to the battlefield, then return another creature card from your graveyard to your hand.",
    "ir": "abilities[0].effect.steps[0] (graveyard -> battlefield), abilities[0].effect.steps[1] (graveyard -> hand)"
   }
  ],

  "draft_py": "# Moment of Heroism (M20) -- Target creature gets +2/+2 and gains lifelink until end of turn.\n_target_creature = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Seq(\n            steps=(\n                A(Verb.MODIFY_PT, {\n                    'duration': DurationEot(),\n                    'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n                    'target': _target_creature,\n                    'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n                }),\n                A(Verb.GRANT_ABILITY, {\n                    'ability': KeywordAbility(keyword=Keyword.LIFELINK),\n                    'duration': DurationEot(),\n                    'target': _target_creature,\n                }),\n            ),\n        ),\n    ),\n]\n",

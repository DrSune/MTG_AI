 "mapping": {
  "author": "claude-mapper-m20-3",
  "date": "2026-11-05",
  "draft_py": "# Aerial Assault: \"Destroy target tapped creature. You gain 1 life for each creature you control with flying.\"\n# The compiler's destroy step is kept; the life gain is the effect of B2a-aven-gagglemaster\n# (parse \"When this creature enters, you gain 1 life for each creature you control with flying.\").\nspell = compiled[0]\ngain = A(Verb.GAIN_LIFE, {\n    'amount': QBin(\n        op=QBinOp.MUL,\n        left=QConst(value=1),\n        right=QCount(selector=Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                FAtom(pred=FAtomPred.KEYWORD_HAS, keyword=Keyword.FLYING),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        )),\n    ),\n    'controller': ControllerRef.YOU,\n})\nabilities = [SpellAbility(kind=SpellKind.SORCERY, effect=Seq(steps=(spell.effect, gain)))]\n",
  "clauses": [
   {
    "clause": "Destroy target tapped creature.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "You gain 1 life for each creature you control with flying.",
    "ir": "abilities[0].effect.steps[1]"
   }
  ],

  "draft_py": "# Tectonic Rift: \"Destroy target land. Creatures without flying can't block this turn.\"\ndestroy_land = A(Verb.DESTROY, {\n    'target': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.TARGET,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n})\n# canonical: template B5c-bullet-cant-block (M21 Destructive Tampering)\nno_block = A(Verb.PREVENT_EFFECT, {\n    'condition': FAnd(children=()),\n    'duration': DurationEot(),\n    'event': DeclareBlockersEvent(\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FNot(inner=FAtom(pred=FAtomPred.KEYWORD_HAS, keyword=Keyword.FLYING)),\n        )),\n    ),\n})\nabilities = [SpellAbility(kind=SpellKind.SORCERY, effect=Seq(steps=(destroy_land, no_block)))]\n",

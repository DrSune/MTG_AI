  "draft_py": "# Aggressive Mammoth: \"Trample\" (compiled keyword) + \"Other creatures you control have trample.\"\n# Shape: B4-grant-kw-static-you (Garruk's Uprising) with \"other\" = FNot(IS_SOURCE) (Bolt Hound).\nother_trample = StaticAbility(effect=A(Verb.GRANT_ABILITY, {\n    'ability': KeywordAbility(keyword=Keyword.TRAMPLE),\n    'target': Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n}))\nabilities = [other_trample, *compiled]\n",

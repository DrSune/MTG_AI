  "draft_py": "# M20 Golos, Tireless Pilgrim.\n# [0] \"When Golos enters, you may search your library for a land card, put that card onto the\n#     battlefield tapped, then shuffle.\" M21 Solemn Simulacrum's tree (B2b-etb-basic-land) with\n#     \"a land card\" for \"a basic land card\".\n# [1] \"{2}{W}{U}{B}{R}{G}: Exile the top three cards of your library. You may play them this turn\n#     without paying their mana costs.\" The library pop of three (M21 Chandra, Heart of Fire's\n#     [+1], ontology round R13), then the permission over the cards it exiled (the result\n#     register; templates_b19 B19-play-result's tree for \"You may play them this turn without\n#     paying their mana costs.\").\nsearch = A(Verb.SEARCH, {\n    \"cards\": Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value=\"Land\"),\n        zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),),\n    ),\n    \"destination\": Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n    \"tapped_on_enter\": True,\n})\nshuffle = A(Verb.SHUFFLE, {\"zone\": Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU)})\nenters = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=OptionalEffect(inner=Seq(steps=(search, shuffle))),\n)\nexile_three = A(Verb.MOVE_ZONE, {\n    \"amount\": QConst(value=3),\n    \"controller\": ControllerRef.YOU,\n    \"destination\": Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n    \"from\": Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),\n    \"pop_order\": \"TOP\",\n})\nplay_them = A(Verb.PERMIT, {\n    \"alternative\": Cost(),\n    \"duration\": DurationEot(),\n    \"lands\": True,\n    \"source\": Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAnd(children=()),\n        zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n        referent=\"result\",\n    ),\n})\nimpulse = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaGeneric(amount=QConst(value=2)),\n        CostManaColor(color=\"W\", amount=QConst(value=1)),\n        CostManaColor(color=\"U\", amount=QConst(value=1)),\n        CostManaColor(color=\"B\", amount=QConst(value=1)),\n        CostManaColor(color=\"R\", amount=QConst(value=1)),\n        CostManaColor(color=\"G\", amount=QConst(value=1)),\n    )),\n    effect=Seq(steps=(exile_three, play_them)),\n)\n(carrier,) = compiled\nabilities = [enters, impulse, carrier]\n",
  "clauses": [

 "mapping": {
  "author": "claude-mapper-m20-1",
  "date": "2026-11-05",
  "draft_py": "# Pacifism: \"Enchanted creature can't attack or block.\"  Faith's Fetters' compiled static\n# (template B5a-enchant-cant-attack-block), keeping its first two steps (attack, block) and leaving\n# out the activated-ability step Pacifism does not print. The event filters name \"creature\" the\n# way Capture Sphere's \"Enchanted creature doesn't untap ...\" does (B5a-enchant-no-untap):\n# FAnd(IS_ATTACHED_TO_SOURCE, TYPE_EQ Creature), with the bare IS_ATTACHED_TO_SOURCE condition.\nenchanted_creature = FAnd(\n    children=(\n        FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    ),\n)\nstatic = StaticAbility(\n    effect=Seq(\n        steps=(\n            A(Verb.PREVENT_EFFECT, {\n                'condition': FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n                'event': DeclareAttackersEvent(filter=enchanted_creature),\n            }),\n            A(Verb.PREVENT_EFFECT, {\n                'condition': FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n                'event': DeclareBlockersEvent(filter=enchanted_creature),\n            }),\n        ),\n    ),\n)\nabilities = [static, *compiled]\n",
  "clauses": [
   {
    "clause": "Enchant creature",
    "ir": "keywords[0]"
   },
   {
    "clause": "Enchanted creature can't attack or block.",
    "ir": "abilities[0]"

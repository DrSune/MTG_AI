  "draft_py": "# Ajani, Inspiring Leader (M20)\n# +2: You gain 2 life. Put two +1/+1 counters on up to one target creature.\n# -3: Exile target creature. Its controller gains 2 life.\n# -10: Creatures you control gain flying and double strike until end of turn.\n\n_creatures_you_control = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\n\nplus_two = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=2),)),\n    effect=Seq(\n        steps=(\n            A(Verb.GAIN_LIFE, {'amount': QConst(value=2), 'controller': ControllerRef.YOU}),\n            A(Verb.PUT_COUNTER, {\n                'count': QConst(value=2),\n                'counter_kind': CounterKind.PLUS_1_PLUS_1,\n                'target': Selector(\n                    count=QAtMost(n=1),\n                    mode=SelectorMode.TARGET,\n                    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            }),\n        ),\n    ),\n)\n\nminus_three = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=-3),)),\n    effect=Seq(\n        steps=(\n            A(Verb.MOVE_ZONE, {\n                'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n                'target': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.TARGET,\n                    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            }),\n            A(Verb.GAIN_LIFE, {\n                'amount': QConst(value=2),\n                'controller': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(children=()),\n                    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n                    referent='target',\n                ),\n            }),\n        ),\n    ),\n)\n\nminus_ten = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=-10),)),\n    effect=Seq(\n        steps=(\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.FLYING),\n                'duration': DurationEot(),\n                'target': _creatures_you_control,\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.DOUBLE_STRIKE),\n                'duration': DurationEot(),\n                'target': _creatures_you_control,\n            }),\n        ),\n    ),\n)\n\nabilities = [plus_two, minus_three, minus_ten, compiled[2]]\n",

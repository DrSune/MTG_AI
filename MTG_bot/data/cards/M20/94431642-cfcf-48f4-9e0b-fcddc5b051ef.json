 "mapping": {
  "author": "claude-mapper-m20-3",
  "date": "2026-11-05",
  "draft_py": "# Creeping Trailblazer\n# 1. \"Other Elementals you control get +1/+0.\" -- Pack Leader's B4-modify-pt-other-dogs shape,\n#    with Liliana's Devotee's +1/+0 (toughness INCREASE 0).\nother_elementals = StaticAbility(effect=A(Verb.MODIFY_PT, {\n    'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n    'target': Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n    'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n}))\n\n# 2. \"{2}{R}{G}: This creature gets +1/+1 until end of turn for each Elemental you control.\"\n#    -- parse \"{2}{R}{G}: This creature gets +1/+1 until end of turn.\" (B3-modify-pt-self) with\n#    the \"N for each X\" magnitude QBin(MUL, QConst(1), QCount(...)).\nper_elemental = QBin(\n    op=QBinOp.MUL,\n    left=QConst(value=1),\n    right=QCount(selector=Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    )),\n)\npump = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaColor(color='G', amount=QConst(value=1)),\n        CostManaColor(color='R', amount=QConst(value=1)),\n        CostManaGeneric(amount=QConst(value=2)),\n    )),\n    effect=A(Verb.MODIFY_PT, {\n        'duration': DurationEot(),\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=per_elemental),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.ALL,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.IS_SOURCE),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=per_elemental),\n    }),\n)\nabilities = [other_elementals, pump, *compiled]\n",

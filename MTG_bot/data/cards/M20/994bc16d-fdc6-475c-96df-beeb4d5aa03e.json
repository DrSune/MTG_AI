  "draft_py": "# M20 Mystic Forge: the compiler reads the look and the permission (templates_b19); the activated\n# ability \"{T}, Pay 1 life: Exile the top card of your library.\" is the corpus form of \"exile the\n# top card of your library\" (ZNR Valakut Exploration, M21 Furious Rise).\nexile_top = A(Verb.MOVE_ZONE, {\n    \"destination\": Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n    \"target\": Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAnd(children=()),\n        zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU, position=ZonePosition.TOP),),\n    ),\n})\nexile_row = ActivatedAbility(\n    cost=Cost(parts=(CostTap(), CostLife(amount=QConst(value=1)))),\n    effect=exile_top,\n)\nlook, permit, carrier = compiled\nabilities = [look, permit, exile_row, carrier]\n",
  "clauses": [
   {
    "clause": "You may look at the top card of your library any time.",
    "ir": "abilities[0]"
   },
   {
    "clause": "You may cast artifact spells and colorless spells from the top of your library.",
    "ir": "abilities[1]"
   },
   {
    "clause": "{T}, Pay 1 life: Exile the top card of your library.",
    "ir": "abilities[2]"
   }
  ],

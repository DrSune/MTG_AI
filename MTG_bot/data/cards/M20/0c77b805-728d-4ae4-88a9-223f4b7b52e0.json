  "draft_py": "# Corpse Knight (M20). \"Whenever another creature you control enters, each opponent loses 1 life.\"\n# Event: Terror of the Peaks (B2b-other-enters-power-damage). Effect: Caged Zombie's\n# \"Each opponent loses N life\" (LOSE_LIFE, controller ALL_OPPONENTS).\ndrain = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAnd(\n            children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n            ),\n        ),\n    ),\n    condition=None,\n    effect=A(Verb.LOSE_LIFE, {\n        'amount': QConst(value=1),\n        'controller': ControllerRef.ALL_OPPONENTS,\n    }),\n)\nabilities = [drain, *compiled]\n",

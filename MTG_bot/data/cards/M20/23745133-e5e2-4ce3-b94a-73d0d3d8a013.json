  "draft_py": "# Phantom Warrior: This creature can't be blocked.\n# Shape: Tome Anima's \"This creature can't be blocked as long as ...\" without the condition.\nunblockable = StaticAbility(effect=A(Verb.PREVENT_EFFECT, {\n    'condition': FAtom(pred=FAtomPred.IS_SOURCE),\n    'event': DeclareBlockersEvent(\n        filter=FAnd(children=()),\n        blocked=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n}))\nabilities = [unblockable, *compiled]\n",

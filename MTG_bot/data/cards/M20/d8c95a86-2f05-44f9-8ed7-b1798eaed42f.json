  "draft_py": "# M20 Chandra's Regulator (copy round B3, DESIGN_ATOM_ONTOLOGY §18)\n_bf = Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY)\ncopy_trigger = TriggeredAbility(\n    event=AbilityActivatedEvent(\n        source=FAnd(children=(\n            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Chandra'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n        )),\n        kind=AbilityKind.LOYALTY,\n        actor=FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    ),\n    condition=None,\n    effect=Seq(steps=(\n        OptionalEffect(inner=A(Verb.PAY, {\n            'cost': Cost(parts=(CostManaGeneric(amount=QConst(value=1)),)),\n        })),\n        Conditional(\n            pred=FAtom(pred=FAtomPred.MAY_DONE),\n            then_effect=A(Verb.COPY, {\n                'new_targets': True,\n                'source': CopyOf(source=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(children=()),\n                    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n                    referent='event',\n                )),\n            }),\n        ),\n    )),\n)\ndraw = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaGeneric(amount=QConst(value=1)),\n        CostTap(),\n        CostDiscard(target=Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FOr(children=(\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Mountain'),\n                FAtom(pred=FAtomPred.COLOR_HAS, color='R'),\n            )),\n            zones=(Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),),\n        )),\n    )),\n    effect=A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n)\nabilities = [copy_trigger, draw, *compiled]\n",

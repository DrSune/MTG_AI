  "draft_py": "# Kykar, Wind's Fury (M20). Flying is compiled (keywords).\n# s2: Whenever you cast a noncreature spell, create a 1/1 white Spirit creature token with flying.\n#     event: Spellgorger Weird (B2b-noncreature-counter); token: Triplicate Spirits (B11-create-tokens) with count 1.\n# s3: Sacrifice a Spirit: Add {R}.\n#     cost: CostSacrifice CHOOSE you-control (Witch's Cauldron); tribal noun = SUBTYPE_EQ + TYPE_EQ Creature (guide);\n#     effect: B3-add-mana-single ({T}: Add {R}.)\nspirit = TokenSpec(\n    name='Spirit',\n    type_line='Creature — Spirit',\n    types=('Creature',),\n    subtypes=('Spirit',),\n    power=QConst(value=1),\n    toughness=QConst(value=1),\n    keywords=(Keyword.FLYING,),\n    abilities=(),\n    colors=('W',),\n)\ncast_trigger = TriggeredAbility(\n    event=CastSpellEvent(\n        filter=FNot(inner=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature')),\n        actor=FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    ),\n    condition=None,\n    effect=A(Verb.CREATE_TOKEN, {'count': QConst(value=1), 'tokens': spirit}),\n)\nsac_for_red = ActivatedAbility(\n    cost=Cost(\n        parts=(\n            CostSacrifice(\n                target=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(\n                        children=(\n                            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Spirit'),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                        ),\n                    ),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            ),\n        ),\n    ),\n    effect=A(Verb.ADD_MANA, {'amount': QConst(value=1), 'color': 'R', 'controller': ControllerRef.YOU}),\n)\nabilities = [cast_trigger, sac_for_red, *compiled]\n",

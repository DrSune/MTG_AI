 "mapping": {
  "author": "claude-mapper-m20-1",
  "date": "2026-11-05",
  "draft_py": "# Ironroot Warlord: \"Ironroot Warlord's power is equal to the number of creatures you control.\"\n# A characteristic-defining ability (CR 604.3): Kinetic Augur's SET_PT static with the power role\n# only (toughness stays the printed 5); the count is Kabira Takedown's \"the number of creatures you\n# control\" census (it includes this creature).\ncda = StaticAbility(\n    effect=A(Verb.SET_PT, {\n        'power': QCount(\n            selector=Selector(\n                count=QUnbounded(),\n                mode=SelectorMode.ALL,\n                filter=FAnd(\n                    children=(\n                        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    ),\n                ),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n        ),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [cda, *compiled]\n",
  "clauses": [
   {
    "clause": "Ironroot Warlord's power is equal to the number of creatures you control.",
    "ir": "abilities[0]"
   },
   {
    "clause": "{3}{G}{W}: Create a 1/1 white Soldier creature token.",
    "ir": "abilities[1]"
   }
  ],

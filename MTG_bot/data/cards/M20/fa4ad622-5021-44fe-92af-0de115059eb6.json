 "mapping": {
  "author": "claude-mapper-m20-0",
  "date": "2026-11-05",
  "draft_py": "# Lavakin Brawler (M20). \"Whenever this creature attacks, it gets +1/+0 until end of turn for each\n# Elemental you control.\" Grotag Bug-Catcher's attack pump (B8-party-attack-pt) with the party count\n# replaced by a QCount of \"Elementals you control\" (Pack Leader's tribal filter without \"other\":\n# the Brawler, an Elemental, counts itself), as Aven Gagglemaster counts \"creatures you control\".\nelementals_you_control = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nattack = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=A(Verb.MODIFY_PT, {\n        'duration': DurationEot(),\n        'power': PtDelta(\n            direction=PtDirection.INCREASE,\n            magnitude=QBin(op=QBinOp.MUL, left=QConst(value=1), right=QCount(selector=elementals_you_control)),\n        ),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n    }),\n)\nabilities = [attack, *compiled]\n",
  "clauses": [
   {
    "clause": "Whenever this creature attacks, it gets +1/+0 until end of turn for each Elemental you control.",
    "ir": "abilities[0]"
   }

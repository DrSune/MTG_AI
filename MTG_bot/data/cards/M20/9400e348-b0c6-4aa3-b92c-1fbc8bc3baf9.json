 "mapping": {
  "author": "claude-mapper-m20-3",
  "date": "2026-11-05",
  "draft_py": "# Frost Lynx: \"When this creature enters, tap target creature an opponent controls. That creature\n# doesn't untap during its controller's next untap step.\"\n# The compiler's ETB tap is kept; the second sentence is Frost Breath's B5c-those-no-untap-next\n# step (singular target), appended in a Seq like Frost Breath's spell effect.\netb = compiled[0]\nno_untap = A(Verb.PREVENT_EFFECT, {\n    'condition': FAtom(pred=FAtomPred.IS_ANY_TARGET),\n    'duration': DurationUntilNextStep(step=Step.UNTAP),\n    'event': TapStateEvent(tapped=False, filter=FAtom(pred=FAtomPred.IS_ANY_TARGET)),\n    'step': Step.UNTAP,\n})\ntrigger = TriggeredAbility(event=etb.event, condition=etb.condition,\n                           effect=Seq(steps=(etb.effect, no_untap)))\nabilities = [trigger, *compiled[1:]]\n",
  "clauses": [
   {
    "clause": "When this creature enters, tap target creature an opponent controls.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "That creature doesn't untap during its controller's next untap step.",
    "ir": "abilities[0].effect.steps[1]"
   }
  ],

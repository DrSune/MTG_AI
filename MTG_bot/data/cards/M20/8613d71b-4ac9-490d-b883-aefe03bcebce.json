 "mapping": {
  "author": "claude-mapper-m20-0",
  "date": "2026-11-05",
  "draft_py": "# Hard Cover (M20). \"Enchanted creature gets +0/+2 and has \"{T}: Draw a card, then discard a card.\"\"\n# Infernal Scarring's static (B5a-enchant-pt-death-draw: a Seq of MODIFY_PT and GRANT_ABILITY over\n# the enchanted creature) with +0/+2 and, as the granted ability, Obsessive Stitcher's loot\n# (B3-seq-draw-discard). The Enchant keyword and the Aura carrier are the compiler's, kept.\nenchanted = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nloot = ActivatedAbility(\n    cost=Cost(parts=(CostTap(),)),\n    effect=Seq(\n        steps=(\n            A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n            A(Verb.MOVE_ZONE, {\n                'cards': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(children=()),\n                    zones=(Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),),\n                ),\n                'controller': ControllerRef.YOU,\n                'destination': Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),\n                'from': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n            }),\n        ),\n    ),\n)\nstatic = StaticAbility(\n    effect=Seq(\n        steps=(\n            A(Verb.MODIFY_PT, {\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n                'target': enchanted,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n            }),\n            A(Verb.GRANT_ABILITY, {'ability': loot, 'target': enchanted}),\n        ),\n    ),\n)\nabilities = [static, *compiled]\n",
  "clauses": [
   {
    "clause": "Enchant creature",
    "ir": "keywords[0]"
   },
   {
    "clause": "Enchanted creature gets +0/+2 and has \"{T}: Draw a card, then discard a card.\"",
    "ir": "abilities[0]"
   }
  ],
  "g0_warnings": [],
  "notes": "G1 shows +0/+2 on every legal host but never activates the granted loot. Packs in /tmp/claude-1000/-home-sune/2e18468a-eed7-47b5-a69b-d15b1f5fd0e8/scratchpad/round_m20/mapped/m0/hard_cover: pack_loot_own.json (draw then discard, creature taps), pack_loot_opponent.json (on an opponent's creature the opponent loots)."
 },

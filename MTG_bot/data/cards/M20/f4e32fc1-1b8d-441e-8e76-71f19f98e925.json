 "mapping": {
  "author": "ontology-b12",
  "date": "2026-11-18",
  "draft_py": "# Leyline of the Void (M20): the opening-hand sentence compiles (B21-opening-hand); the record adds\n# \"If a card would be put into an opponent's graveyard from anywhere, exile it instead.\" (CR 614.1a,\n# 614.6): a replacement of a card's move from any zone into the graveyard of its owner, an opponent\n# (CR 400.3: a card goes to its owner's graveyard), the action Scorching Dragonfire's exile of the\n# event's object. \"A card\": a token is no card (CR 108.2), so tokens still die (the ruling).\nreplacement = ReplacementAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.OPPONENT),\n        subject=FNot(inner=FAtom(pred=FAtomPred.IS_TOKEN)),\n    ),\n    condition=None,\n    action=A(Verb.MOVE_ZONE, {\n        'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAnd(children=()),\n            zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n            referent='event',\n        ),\n    }),\n)\nabilities = [compiled[0], replacement, compiled[1]]\n",
  "clauses": [
   {
    "clause": "If this card is in your opening hand, you may begin the game with it on the battlefield.",
    "ir": "abilities[0]"
   },
   {
    "clause": "If a card would be put into an opponent's graveyard from anywhere, exile it instead.",
    "ir": "abilities[1]"
   }
  ],

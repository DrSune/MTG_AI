  "date": "2026-11-05",
  "draft_py": "# Audacious Thief: \"Whenever this creature attacks, you draw a card and you lose 1 life.\"\n# Library Larcenist's attack trigger; the compound effect is a Seq in printed order (Spirit of\n# Malevolence's \"... and you gain 1 life\"), the lose-life atom is Grim Tutor's.\nattack = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=Seq(\n        steps=(\n            A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n            A(Verb.LOSE_LIFE, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n        ),\n    ),\n)\nabilities = [attack, *compiled]\n",
  "clauses": [
   {
    "clause": "Whenever this creature attacks, you draw a card and you lose 1 life.",

 "mapping": {
  "author": "claude-mapper-m20-1",
  "date": "2026-11-05",
  "draft_py": "# Battalion Foot Soldier: \"When this creature enters, you may search your library for any number\n# of cards named Battalion Foot Soldier, reveal them, put them into your hand, then shuffle.\"\n# Fierce Empath's optional ETB tutor (SEARCH to hand, REVEAL, SHUFFLE; no SEARCH controller role,\n# guide D12) with Alpine Houndmaster's NAME_EQ filter and \"reveal them\" (QUnbounded), and\n# Chandra, Heart of Fire's \"any number of\" = CHOOSE with QUnbounded.\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=OptionalEffect(\n        inner=Seq(\n            steps=(\n                A(Verb.SEARCH, {\n                    'cards': Selector(\n                        count=QUnbounded(),\n                        mode=SelectorMode.CHOOSE,\n                        filter=FAtom(pred=FAtomPred.NAME_EQ, string_value='Battalion Foot Soldier'),\n                        zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),),\n                    ),\n                    'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n                }),\n                A(Verb.REVEAL, {'controller': ControllerRef.YOU, 'count': QUnbounded()}),\n                A(Verb.SHUFFLE, {'zone': Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU)}),\n            ),\n        ),\n    ),\n)\nabilities = [etb, *compiled]\n",
  "clauses": [
   {
    "clause": "When this creature enters, you may search your library for any number of cards named Battalion Foot Soldier, reveal them, put them into your hand, then shuffle.",
    "ir": "abilities[0]"

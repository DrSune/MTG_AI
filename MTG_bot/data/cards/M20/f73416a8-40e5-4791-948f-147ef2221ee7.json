  "draft_py": "# Might of the Masses (M20).\n# \"Target creature gets +1/+1 until end of turn for each creature you control.\"\n# Target pump of Sure Strike / Bone Pit Brute (MODIFY_PT, TARGET creature, DurationEot) with the\n# guide's \"N for each X\" magnitude QBin(MUL, QConst(N), QCount(...)); \"creature you control\" is\n# the census of Basri's Solidarity / Kabira Outrider (CONTROLLER_IS YOU + TYPE_EQ Creature).\nper_creature = QBin(\n    op=QBinOp.MUL,\n    left=QConst(value=1),\n    right=QCount(\n        selector=Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    ),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=A(Verb.MODIFY_PT, {\n            'duration': DurationEot(),\n            'power': PtDelta(direction=PtDirection.INCREASE, magnitude=per_creature),\n            'target': Selector(\n                count=QConst(value=1),\n                mode=SelectorMode.TARGET,\n                filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n            'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=per_creature),\n        }),\n    ),\n]\n",
  "clauses": [

 "mapping": {
  "author": "claude-mapper-m20-1",
  "date": "2026-11-05",
  "draft_py": "# Empyrean Eagle: \"Other creatures you control with flying get +1/+1.\"  Pack Leader's \"Other Dogs\n# you control get +1/+1\" static with the subtype conjunct replaced by Aven Gagglemaster's \"with\n# flying\" (KEYWORD_HAS FLYING).\nanthem = StaticAbility(\n    effect=A(Verb.MODIFY_PT, {\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n        'target': Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FAtom(pred=FAtomPred.KEYWORD_HAS, keyword=Keyword.FLYING),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n    }),\n)\nabilities = [anthem, *compiled]\n",

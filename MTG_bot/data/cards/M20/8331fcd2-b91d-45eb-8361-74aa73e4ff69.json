  "draft_py": "# Herald of the Sun (M20) -- Flying (compiled)\n# {3}{W}: Put a +1/+1 counter on another target creature with flying.\npump = ActivatedAbility(\n    cost=Cost(\n        parts=(\n            CostManaColor(color='W', amount=QConst(value=1)),\n            CostManaGeneric(amount=QConst(value=3)),\n        ),\n    ),\n    effect=A(Verb.PUT_COUNTER, {\n        'count': QConst(value=1),\n        'counter_kind': CounterKind.PLUS_1_PLUS_1,\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FAtom(pred=FAtomPred.KEYWORD_HAS, keyword=Keyword.FLYING),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [pump, *compiled]\n",

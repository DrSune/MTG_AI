  "draft_py": "keywords = []\n_lands_you_control = Selector(\n    QUnbounded(), SelectorMode.ALL,\n    FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    # [0] This land enters tapped.\n    EtBState(tapped=True),\n    # [1] {T}: Add {C}.\n    compiled[1],\n    # [2] Whenever this land or another land you control enters, if you control seven or more lands\n    # with different names, create a 2/2 black Zombie creature token.\n    TriggeredAbility(\n        event=ZoneChangeEvent(\n            from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n            to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n            subject=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n            )),\n        ),\n        condition=at_least(7, quantity=QDistinct(_lands_you_control, QPropField.NAME)),\n        effect=A(Verb.CREATE_TOKEN, {\n            'count': QConst(value=1),\n            'tokens': TokenSpec(\n                name='Zombie', type_line='Creature — Zombie', types=('Creature',),\n                subtypes=('Zombie',), power=QConst(value=2), toughness=QConst(value=2),\n                keywords=(), abilities=(), colors=('B',),\n            ),\n        }),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "This land enters tapped.",
    "ir": "abilities[0]: EtBState(tapped)"
   },
   {
    "clause": "{T}: Add {C}.",
    "ir": "abilities[1]: the compiler's ADD_MANA C"
   },
   {
    "clause": "Whenever this land or another land you control enters, if you control seven or more lands with different names, create a 2/2 black Zombie creature token.",
    "ir": "abilities[2]: ZoneChangeEvent(to BATTLEFIELD YOU, subject FAnd(CONTROLLER_IS YOU, TYPE_EQ Land)), itself included; condition at_least(7, QDistinct(lands you control, NAME)): seven lands with pairwise different names exist iff there are seven different names among the lands you control (CR 201.2); an intervening if (CR 603.4); CREATE_TOKEN one 2/2 black Zombie"
   }
  ],

 "mapping": {
  "author": "claude-mapper-m20-5",
  "date": "2026-11-05",
  "draft_py": "# Ajani, Strength of the Pride\n# s1 [+1]: You gain life equal to the number of creatures you control plus the\n#          number of planeswalkers you control.\n# s2 [−2]: Create a 2/2 white Cat Soldier creature token named Ajani's Pridemate\n#          with \"Whenever you gain life, put a +1/+1 counter on this token.\"\n# s3 [0]:  If you have at least 15 life more than your starting life total, exile\n#          Ajani and each artifact and creature your opponents control.\ndef _you_control(type_name):\n    return QCount(selector=Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value=type_name),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ))\n\nplus1 = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=1),)),\n    effect=A(Verb.GAIN_LIFE, {\n        'amount': QBin(op=QBinOp.ADD, left=_you_control('Creature'), right=_you_control('Planeswalker')),\n        'controller': ControllerRef.YOU,\n    }),\n)\n\npridemate_trigger = TriggeredAbility(\n    event=LifeGainedEvent(actor=FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU)),\n    condition=None,\n    effect=A(Verb.PUT_COUNTER, {\n        'count': QConst(value=1),\n        'counter_kind': CounterKind.PLUS_1_PLUS_1,\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nminus2 = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=-2),)),\n    effect=A(Verb.CREATE_TOKEN, {\n        'count': QConst(value=1),\n        'tokens': TokenSpec(\n            name=\"Ajani's Pridemate\",\n            type_line='Creature — Cat Soldier',\n            types=('Creature',),\n            subtypes=('Cat', 'Soldier'),\n            power=QConst(value=2),\n            toughness=QConst(value=2),\n            keywords=(),\n            abilities=(pridemate_trigger,),\n            colors=('W',),\n        ),\n    }),\n)\n\nzero = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=0),)),\n    effect=Conditional(\n        pred=FAtom(pred=FAtomPred.LIFE_LEAD_OVER_START_GE, count=QConst(value=15)),\n        then_effect=A(Verb.MOVE_ZONE, {\n            'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n            'target': Selector(\n                count=QUnbounded(),\n                mode=SelectorMode.ALL,\n                filter=FOr(children=(\n                    FAtom(pred=FAtomPred.IS_SOURCE),\n                    FAnd(children=(\n                        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.OPPONENT),\n                        FOr(children=(\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Artifact'),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                        )),\n                    )),\n                )),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n        }),\n    ),\n)\nabilities = [plus1, minus2, zero, *compiled]\n",

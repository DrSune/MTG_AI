 "mapping": {
  "author": "claude-mapper-m20-5",
  "date": "2026-11-05",
  "draft_py": "# Omnath, Locus of the Roil\n# s1: When Omnath enters, it deals damage to any target equal to the number of\n#     Elementals you control.\n# s2+s3: Landfall — Whenever a land you control enters, put a +1/+1 counter on\n#     target Elemental you control. If you control eight or more lands, draw a card.\n_elementals_you_control = FAnd(children=(\n    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elemental'),\n    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n))\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.DEAL_DAMAGE, {\n        'amount': QCount(\n            selector=Selector(\n                count=QUnbounded(),\n                mode=SelectorMode.ALL,\n                filter=_elementals_you_control,\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n        ),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FOr(children=(\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Player'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nlandfall = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n        )),\n    ),\n    condition=None,\n    effect=Seq(steps=(\n        A(Verb.PUT_COUNTER, {\n            'count': QConst(value=1),\n            'counter_kind': CounterKind.PLUS_1_PLUS_1,\n            'target': Selector(\n                count=QConst(value=1),\n                mode=SelectorMode.TARGET,\n                filter=_elementals_you_control,\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n        }),\n        Conditional(\n            pred=FAtom(\n                pred=FAtomPred.CONTROLLER_COUNT_GE,\n                count=QConst(value=8),\n                inner_filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n            ),\n            then_effect=A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n        ),\n    )),\n)\nabilities = [etb, landfall, *compiled]\n",
  "clauses": [

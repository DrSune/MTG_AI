  "draft_py": "# Rapacious Dragon: \"When this creature enters, create two Treasure tokens.\"\n# ETB event: Valorous Steed's B2a-valorous-steed trigger. Token: the Treasure TokenSpec exactly as the\n# compiler writes it in Gadrak, the Crown-Scourge's B2a-gadrak-treasures (verified, M21), count 2.\ntreasure = TokenSpec(\n    name='Treasure',\n    type_line='Artifact',\n    types=('Artifact',),\n    subtypes=(),\n    power=None,\n    toughness=None,\n    keywords=(Keyword.TREASURE,),\n    abilities=(\n        ActivatedAbility(\n            cost=Cost(parts=(\n                CostSacrifice(target=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAtom(pred=FAtomPred.IS_SOURCE),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                )),\n                CostTap(),\n            )),\n            effect=A(Verb.ADD_MANA, {\n                'amount': QConst(value=1),\n                'color': 'ANY',\n                'controller': ControllerRef.YOU,\n            }),\n        ),\n    ),\n)\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.CREATE_TOKEN, {'count': QConst(value=2), 'tokens': treasure}),\n)\nabilities = [etb, *compiled]\n",

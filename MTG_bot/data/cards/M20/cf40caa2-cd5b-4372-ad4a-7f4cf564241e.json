  "draft_py": "# Celestial Messenger: \"This creature gets +1/+1 as long as you control a Yanling planeswalker.\"\n# (the B4-modify-pt-while-garruk shape with the subtype Yanling); Flash and Flying compiled.\nstatic = StaticAbility(\n    effect=A(Verb.MODIFY_PT, {\n        'duration': DurationWhileCondition(\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Yanling'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n            )),\n        ),\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n    }),\n)\nabilities = [static, *compiled]\n",

  "draft_py": "# Bishop of Wings\n# s1: Whenever an Angel you control enters, you gain 4 life.\n# s2: Whenever an Angel you control dies, create a 1/1 white Spirit creature token with flying.\n_angel_you_control = FAnd(children=(\n    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Angel'),\n    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n))\nenters = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=_angel_you_control,\n    ),\n    condition=None,\n    effect=A(Verb.GAIN_LIFE, {'amount': QConst(value=4), 'controller': ControllerRef.YOU}),\n)\ndies = TriggeredAbility(\n    event=CreatureDiesEvent(filter=_angel_you_control),\n    condition=None,\n    effect=A(Verb.CREATE_TOKEN, {\n        'count': QConst(value=1),\n        'tokens': TokenSpec(\n            name='Spirit',\n            type_line='Creature — Spirit',\n            types=('Creature',),\n            subtypes=('Spirit',),\n            power=QConst(value=1),\n            toughness=QConst(value=1),\n            keywords=(Keyword.FLYING,),\n            abilities=(),\n            colors=('W',),\n        ),\n    }),\n)\nabilities = [enters, dies, *compiled]\n",
  "clauses": [

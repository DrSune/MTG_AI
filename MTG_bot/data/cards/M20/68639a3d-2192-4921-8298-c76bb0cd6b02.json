  "date": "2026-11-05",
  "draft_py": "# Moldervine Reclamation (M20): Whenever a creature you control dies, you gain 1 life and draw a card.\n# Event: Basri's Lieutenant's CreatureDiesEvent filter (\"this creature or another creature you control\" = any creature you control).\n# Effect: Witch's Cauldron's \"You gain 1 life and draw a card.\" Seq.\ndies_trigger = TriggeredAbility(\n    event=CreatureDiesEvent(\n        filter=FAnd(\n            children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            ),\n        ),\n    ),\n    condition=None,\n    effect=Seq(\n        steps=(\n            A(Verb.GAIN_LIFE, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n            A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n        ),\n    ),\n)\nabilities = [dies_trigger, *compiled]\n",
  "clauses": [

 "mapping": {
  "author": "claude-mapper-m20-3",
  "date": "2026-11-05",
  "draft_py": "# Trusted Pegasus: \"Whenever this creature attacks, target attacking creature without flying gains\n# flying until end of turn.\"  (Flying: the compiler's keyword, kept.)\n# Event: Library Larcenist's \"Whenever this creature attacks\" (B2b-library-larcenist). Effect: Gale\n# Swooper's \"target creature gains flying until end of turn\" (B2a-gale-swooper) with the target narrowed\n# by Warded Battlements' IS_ATTACKING and Destructive Tampering's \"without flying\".\ntrigger = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=A(Verb.GRANT_ABILITY, {\n        'ability': KeywordAbility(keyword=Keyword.FLYING),\n        'duration': DurationEot(),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.IS_ATTACKING),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                FNot(inner=FAtom(pred=FAtomPred.KEYWORD_HAS, keyword=Keyword.FLYING)),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [trigger, *compiled]\n",

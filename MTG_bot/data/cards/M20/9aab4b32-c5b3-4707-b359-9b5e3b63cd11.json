 "mapping": {
  "author": "claude-mapper-m20-3",
  "date": "2026-11-05",
  "draft_py": "# Reduce to Ashes: \"Reduce to Ashes deals 5 damage to target creature. If that creature would die this\n# turn, exile it instead.\"\n# The compiler's damage spell is kept; the second sentence is Scorching Dragonfire's\n# B5b-repl-die-exile ReplacementAbility, placed before the SpellAbility as in that verified card.\nrepl = ReplacementAbility(\n    event=CreatureDiesEvent(filter=FAtom(pred=FAtomPred.IS_ANY_TARGET)),\n    condition=None,\n    action=A(Verb.MOVE_ZONE, {\n        'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAnd(children=()),\n            zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n            referent='event',\n        ),\n    }),\n)\nabilities = [repl, *compiled]\n",
  "clauses": [
   {
    "clause": "Reduce to Ashes deals 5 damage to target creature.",
    "ir": "abilities[1].effect"
   },

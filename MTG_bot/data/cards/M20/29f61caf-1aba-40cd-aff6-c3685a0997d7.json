  "draft_py": "# Riddlemaster Sphinx: \"Flying\" (compiled keyword) +\n# \"When this creature enters, you may return target creature an opponent controls to its owner's hand.\"\n# Shape: frame B13-etb+B11-bounce-np (the non-\"may\" wording parses) wrapped in OptionalEffect\n# exactly as M21 Niambi's \"When Niambi enters, you may return another target creature ...\".\netb_bounce = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=OptionalEffect(inner=A(Verb.MOVE_ZONE, {\n        'cards': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.OPPONENT),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.OWNER),\n    })),\n)\nabilities = [etb_bounce, *compiled]\n",
  "clauses": [
   {
    "clause": "Flying",
    "ir": "keywords[0]"
   },
   {
    "clause": "When this creature enters, you may return target creature an opponent controls to its owner's hand.",
    "ir": "abilities[0]"
   }

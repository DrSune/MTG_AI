  "draft_py": "EQUIPPED = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\n# One static's keyword grants share a timestamp (CR 613.7): sorted by name (divergence D23).\ngrant = StaticAbility(\n    effect=Seq(\n        steps=(\n            A(Verb.GRANT_ABILITY, {'ability': KeywordAbility(keyword=Keyword.HASTE), 'target': EQUIPPED}),\n            A(Verb.GRANT_ABILITY, {'ability': KeywordAbility(keyword=Keyword.HEXPROOF), 'target': EQUIPPED}),\n        ),\n    ),\n)\nabilities = [grant, *compiled]\n",
  "clauses": [
   {
    "clause": "Equipped creature has hexproof and haste.",

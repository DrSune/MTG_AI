  "draft_py": "# compiled[0]: Raid — When this creature enters, if you attacked this turn, look at the top three\n# cards of your library.  (kept: its event, its intervening \"if\" and the LOOK_AT)\nhead = compiled[0]\nTOP = Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU, position=ZonePosition.TOP)\nraid = TriggeredAbility(\n    event=head.event,\n    condition=head.condition,\n    effect=Seq(\n        steps=(\n            head.effect,\n            OptionalEffect(\n                inner=A(Verb.MOVE_ZONE, {\n                    'cards': Selector(\n                        count=QConst(value=1),\n                        mode=SelectorMode.ONE_OF,\n                        filter=FAnd(children=()),\n                        zones=(TOP,),\n                    ),\n                    'destination': TOP,\n                }),\n            ),\n            A(Verb.MOVE_ZONE, {\n                'cards': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.REST,\n                    filter=FAnd(children=()),\n                    zones=(TOP,),\n                ),\n                'destination': Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),\n            }),\n        ),\n    ),\n)\nabilities = [raid, compiled[1]]\n",
  "clauses": [
   {
    "clause": "Deathtouch",
    "ir": "keywords[0]"
   },
   {
    "clause": "Raid — When this creature enters, if you attacked this turn, look at the top three cards of your library.",
    "ir": "abilities[0].event, abilities[0].condition, abilities[0].effect.steps[0]"
   },
   {
    "clause": "You may put one of those cards back on top of your library.",
    "ir": "abilities[0].effect.steps[1]"
   },
   {
    "clause": "Put the rest into your graveyard.",
    "ir": "abilities[0].effect.steps[2]"
   }

 "mapping": {
  "author": "claude-mapper-m4",
  "date": "2026-11-17",
  "draft_py": "# FDN Balmor, Battlemage Captain: \"Whenever you cast an instant or sorcery spell, creatures you\n# control get +1/+0 and gain trample until end of turn.\"  ZNR Umara Mystic's cast event over\n# instants and sorceries; M21 Crash Through's trample grant and the same ALL selector for the\n# +1/+0 (Defiant Strike's +N/+0), in printed order.\nYOURS = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\ncharge = TriggeredAbility(\n    event=CastSpellEvent(\n        filter=FOr(\n            children=(\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Instant'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Sorcery'),\n            ),\n        ),\n        actor=FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    ),\n    condition=None,\n    effect=Seq(\n        steps=(\n            A(Verb.MODIFY_PT, {\n                'duration': DurationEot(),\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n                'target': YOURS,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.TRAMPLE),\n                'duration': DurationEot(),\n                'target': YOURS,\n            }),\n        ),\n    ),\n)\nabilities = [charge, *compiled]\n",
  "clauses": [

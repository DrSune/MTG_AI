  "draft_py": "# FDN Blanchwood Armor {2}{G} Enchantment - Aura\n# \"Enchant creature\" / \"Enchanted creature gets +1/+1 for each Forest you control.\"\n# Enchant: the keyword carries its host filter (B-65; the compiler's B1-enchant-creature bytes, as\n# M20 Feral Invocation). The static: the B11-attached-pt subject with \"N for each X\" as\n# QBin(MUL, QConst(1), QCount(...)); \"Forest you control\" written like Rin and Seri's\n# \"Cats you control\" (CONTROLLER_IS YOU + SUBTYPE_EQ + the card type), here TYPE_EQ 'Land'.\n_forests = QBin(\n    op=QBinOp.MUL,\n    left=QConst(value=1),\n    right=QCount(\n        selector=Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Forest'),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    ),\n)\nkeywords = [\n    KeywordAbility(\n        keyword=Keyword.ENCHANT,\n        params=(FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),),\n    ),\n]\nabilities = [\n    StaticAbility(\n        effect=A(Verb.MODIFY_PT, {\n            'power': PtDelta(direction=PtDirection.INCREASE, magnitude=_forests),\n            'target': Selector(\n                count=QUnbounded(),\n                mode=SelectorMode.ALL,\n                filter=FAnd(\n                    children=(\n                        FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    ),\n                ),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n            'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=_forests),\n        }),\n    ),\n    SpellAbility(kind=SpellKind.ENCHANTMENT),\n]\n",
  "clauses": [
   {
    "clause": "Enchant creature",
    "ir": "keywords[0]"
   },
   {
    "clause": "Enchanted creature gets +1/+1 for each Forest you control.",
    "ir": "abilities[0]"
   }
  ],
  "g0_warnings": [],
  "notes": "Remap (blind review): ENCHANT now carries the host filter TYPE_EQ 'Creature' (B-65; was bare ENCHANT, which could enchant any permanent). Static unchanged."

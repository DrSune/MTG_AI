  "draft_py": "EQUIPPED = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.IS_ATTACHED_TO_SOURCE),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nyour_turn_bonus = StaticAbility(\n    effect=Seq(\n        steps=(\n            A(Verb.MODIFY_PT, {\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n                'target': EQUIPPED,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.FIRST_STRIKE),\n                'target': EQUIPPED,\n            }),\n        ),\n    ),\n    condition=FAtom(pred=FAtomPred.TURN_OF, who=ControllerRef.YOU),\n)\n# compiled: [0] Equip {2} (sorcery timing), [1] the carrier\nabilities = [your_turn_bonus, *compiled]\n",

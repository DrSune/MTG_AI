  "draft_py": "SELF = Selector(\n    count=QConst(value=1), mode=SelectorMode.CHOOSE, filter=FAtom(pred=FAtomPred.IS_SOURCE),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))\n# Whenever this creature becomes tapped, exile up to one target card from a graveyard and put a\n# +1/+1 counter on this creature.\nbecomes_tapped = TriggeredAbility(\n    event=TapStateEvent(tapped=True, filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=Seq(steps=(\n        A(Verb.MOVE_ZONE, {\n            'cards': Selector(\n                count=QAtMost(n=1), mode=SelectorMode.TARGET, filter=FAnd(children=()),\n                zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.ANY),)),\n            'destination': Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER),\n        }),\n        A(Verb.PUT_COUNTER, {\n            'count': QConst(value=1),\n            'counter_kind': CounterKind.PLUS_1_PLUS_1,\n            'target': SELF,\n        }),\n    )),\n)\n# Sacrifice another creature: This creature gains indestructible until end of turn. Tap it.\nsac_another = ActivatedAbility(\n    cost=Cost(parts=(CostSacrifice(target=Selector(\n        count=QConst(value=1), mode=SelectorMode.CHOOSE,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))),)),\n    effect=Seq(steps=(\n        A(Verb.GRANT_ABILITY, {\n            'ability': KeywordAbility(keyword=Keyword.INDESTRUCTIBLE),\n            'duration': DurationEot(),\n            'target': SELF,\n        }),\n        A(Verb.TAP, {'target': SELF}),\n    )),\n)\nabilities = [becomes_tapped, sac_another, *compiled]\n",

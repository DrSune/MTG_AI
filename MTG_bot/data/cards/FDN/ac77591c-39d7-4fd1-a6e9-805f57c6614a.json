  "draft_py": "# Pirate's Cutlass:\n#  \"When this Equipment enters, attach it to target Pirate you control.\"\n#  \"Equipped creature gets +2/+1.\"            (compiled, kept)\n#  \"Equip {2}\" (= {2}: Attach to target creature you control. Equip only as a sorcery. CR 702.6a)\nstatic_pt, equip = compiled\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.ATTACH, {\n        'equipment': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Pirate'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\n# The compiled equip (template B5a-equip) predates ActivatedAbility.timing and drops\n# \"Equip only as a sorcery\" (its own GAP comment); restore it with the existing timing slot.\nequip_sorcery = ActivatedAbility(cost=equip.cost, effect=equip.effect, timing=ActivationWindow.SORCERY)\nabilities = [etb, static_pt, equip_sorcery, SpellAbility(kind=SpellKind.ARTIFACT)]\n",

 "mapping": {
  "author": "claude-mapper-M2",
  "date": "2026-11-17",
  "draft_py": "# Overrun: \"Creatures you control get +3/+3 and gain trample until end of turn.\"\n# M20 Overcome's verified record (the same sentence with +2/+2), by slot: MODIFY_PT and\n# GRANT_ABILITY(TRAMPLE), each until end of turn over ALL creatures you control. The compiler gave\n# no tree; the sorcery carrier holds the Seq. (The reminder text is not a clause.)\nyours = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.SORCERY,\n        effect=Seq(steps=(\n            A(Verb.MODIFY_PT, {\n                'duration': DurationEot(),\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=3)),\n                'target': yours,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=3)),\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.TRAMPLE),\n                'duration': DurationEot(),\n                'target': yours,\n            }),\n        )),\n    ),\n]\n",
  "clauses": [

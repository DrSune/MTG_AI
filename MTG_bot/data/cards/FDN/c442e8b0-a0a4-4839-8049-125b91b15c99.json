 "mapping": {
  "author": "claude-mapper-M2",
  "date": "2026-11-17",
  "draft_py": "# Heroic Reinforcements: \"Create two 1/1 white Soldier creature tokens. Until end of turn, creatures\n# you control get +1/+1 and gain haste.\"\n# Sentence 1 is the compiler's CREATE_TOKEN, kept. Sentence 2 is M20 Overcome's verified shape (by\n# slot): MODIFY_PT +1/+1 and GRANT_ABILITY(HASTE), each until end of turn over ALL creatures you\n# control, after the tokens (so the two Soldiers get it too, in printed order).\ncreate = compiled[0].effect\nyours = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.SORCERY,\n        effect=Seq(steps=(\n            create,\n            A(Verb.MODIFY_PT, {\n                'duration': DurationEot(),\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n                'target': yours,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.HASTE),\n                'duration': DurationEot(),\n                'target': yours,\n            }),\n        )),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Create two 1/1 white Soldier creature tokens.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "Until end of turn, creatures you control get +1/+1 and gain haste.",
    "ir": "abilities[0].effect.steps[1], abilities[0].effect.steps[2]"
   }

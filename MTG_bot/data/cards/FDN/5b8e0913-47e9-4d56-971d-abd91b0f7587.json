  "draft_py": "# Patched by gate round W3 (DESIGN_ATOM_ONTOLOGY §20): REVEAL names the cards it shows.\n# FDN Campus Guide: the record's stored tree (rendered by render_records.py)\nkeywords = [\n]\nabilities = [\n    # [0]\n    TriggeredAbility(\n        event=ZoneChangeEvent(\n            from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n            to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n            subject=FAtom(pred=FAtomPred.IS_SOURCE),\n        ),\n        condition=None,\n        effect=OptionalEffect(\n            inner=Seq(\n                steps=(\n                    A(Verb.SEARCH, {\n                        'cards': Selector(\n                            count=QConst(value=1),\n                            mode=SelectorMode.CHOOSE,\n                            filter=FAnd(\n                                children=(\n                                    FAtom(pred=FAtomPred.SUPERTYPE_EQ, string_value='Basic'),\n                                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n                                ),\n                            ),\n                            zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),),\n                        ),\n                        'destination': Zone(\n                            kind=ZoneKind.LIBRARY,\n                            controller=ControllerRef.YOU,\n                            position=ZonePosition.TOP,\n                        ),\n                    }),\n                    reveal_result(),\n                    A(Verb.SHUFFLE, {\n                        'zone': Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),\n                    }),\n                    A(Verb.MOVE_ZONE, {\n                        'cards': Selector(\n                            count=QConst(value=1),\n                            mode=SelectorMode.ONE_OF,\n                            filter=FAnd(\n                                children=(\n                                    FAtom(pred=FAtomPred.SUPERTYPE_EQ, string_value='Basic'),\n                                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n                                ),\n                            ),\n                            zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),),\n                        ),\n                        'destination': Zone(\n                            kind=ZoneKind.LIBRARY,\n                            controller=ControllerRef.YOU,\n                            position=ZonePosition.TOP,\n                        ),\n                    }),\n                ),\n            ),\n        ),\n    ),\n    # [1]\n    SpellAbility(kind=SpellKind.CREATURE),\n]\n",
  "clauses": [
   {
    "clause": "When this creature enters, you may search your library for a basic land card, reveal it, then shuffle and put that card on top.",

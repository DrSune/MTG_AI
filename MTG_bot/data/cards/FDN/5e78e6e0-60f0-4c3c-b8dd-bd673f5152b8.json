  "draft_py": "# FDN Viashino Pyromancer: \"When this creature enters, it deals 2 damage to target player or\n# planeswalker.\"  Event: M21 Skeleton Archer (B2a); target: B12-damage-player-or-planeswalker.\nping = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.DEAL_DAMAGE, {\n        'amount': QConst(value=2),\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FOr(\n                children=(\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_PERMANENT)),\n                ),\n            ),\n            zones=(\n                Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),\n                Zone(kind=ZoneKind.PLAYER, controller=ControllerRef.ANY),\n            ),\n        ),\n    }),\n)\nabilities = [ping, *compiled]\n",

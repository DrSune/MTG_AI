  "draft_py": "# Goblin Firebomb: \"Flash\" (compiled keyword, kept)\n#   \"{7}, {T}, Sacrifice this artifact: Destroy target permanent.\"\nact = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaGeneric(amount=QConst(value=7)),\n        CostTap(),\n        CostSacrifice(target=Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.IS_SOURCE),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        )),\n    )),\n    effect=A(Verb.DESTROY, {\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAtom(pred=FAtomPred.IS_PERMANENT),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [act, SpellAbility(kind=SpellKind.ARTIFACT)]\n",

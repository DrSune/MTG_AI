 "mapping": {
  "author": "claude-mapper-M2",
  "date": "2026-11-17",
  "draft_py": "# Make a Stand: \"Creatures you control get +1/+0 and gain indestructible until end of turn.\"\n# M20 Overcome's verified shape (by slot): MODIFY_PT +1/+0 (toughness +0, as Sure Strike's\n# \"+3/+0\") and GRANT_ABILITY(INDESTRUCTIBLE), each until end of turn over ALL creatures you\n# control. The compiler gave no tree; an instant's carrier holds the Seq.\nyours = Selector(\n    count=QUnbounded(),\n    mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Seq(steps=(\n            A(Verb.MODIFY_PT, {\n                'duration': DurationEot(),\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n                'target': yours,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.INDESTRUCTIBLE),\n                'duration': DurationEot(),\n                'target': yours,\n            }),\n        )),\n    ),\n]\n",
  "clauses": [

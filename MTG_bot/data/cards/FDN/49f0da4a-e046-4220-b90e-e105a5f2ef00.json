  "draft_py": "# Incinerating Blast: \"Incinerating Blast deals 6 damage to target creature. You may discard a card.\n#                      If you do, draw a card.\"\ndamage, draw = compiled[0].effect.steps\ndiscard = A(Verb.MOVE_ZONE, {   # 'discard a card' (B5b-cont-discard / Obsessive Stitcher shape)\n    'cards': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAnd(children=()),\n        zones=(Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),),\n    ),\n    'controller': ControllerRef.YOU,\n    'destination': Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),\n    'from': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n})\n# \"You may X. If you do, Y.\" = Seq(OptionalEffect(X), Conditional(MAY_DONE, Y))  (Crypt Lurker / Jeskai Elder)\nabilities = [SpellAbility(kind=SpellKind.SORCERY, effect=Seq(steps=(\n    damage,\n    OptionalEffect(inner=discard),\n    Conditional(pred=FAtom(pred=FAtomPred.MAY_DONE), then_effect=draw),\n)))]\n",

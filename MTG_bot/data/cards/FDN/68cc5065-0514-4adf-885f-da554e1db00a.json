 "mapping": {
  "author": "claude-b3-copies",
  "date": "2026-11-18",
  "draft_py": "# FDN Abyssal Harvester (copy round B3, DESIGN_ATOM_ONTOLOGY §18)\n_bf = Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY)\n_exile = Zone(kind=ZoneKind.EXILE, controller=ControllerRef.OWNER)\nharvest = ActivatedAbility(\n    cost=Cost(parts=(CostTap(),)),\n    effect=Seq(steps=(\n        # \"Exile target creature card from a graveyard that was put there this turn.\"\n        A(Verb.MOVE_ZONE, {\n            'destination': _exile,\n            'target': Selector(\n                count=QConst(value=1),\n                mode=SelectorMode.TARGET,\n                filter=FAnd(children=(\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FAtom(\n                        pred=FAtomPred.SUBJECT_OF_EVENT_THIS_TURN,\n                        event=ZoneChangeEvent(\n                            from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n                            to_zone=Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.ANY),\n                        ),\n                        count=QConst(value=1),\n                    ),\n                )),\n                zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.ANY),),\n            ),\n        }),\n        # \"Create a token that's a copy of it, except it's a Nightmare in addition to its other\n        # types.\" (B20-copy-token: \"it\" is the card the exile moved, the result register)\n        A(Verb.CREATE_TOKEN, {\n            'count': QConst(value=1),\n            'tokens': CopyOf(\n                source=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(children=()),\n                    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n                    referent='result',\n                ),\n                subtypes=('Nightmare',),\n            ),\n        }),\n        # \"Then exile all other Nightmare tokens you control.\": other than the token just made\n        # (FNot IS_RESULT, the complement of the result register)\n        A(Verb.MOVE_ZONE, {\n            'cards': Selector(\n                count=QUnbounded(),\n                mode=SelectorMode.ALL,\n                filter=FAnd(children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.IS_TOKEN),\n                    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Nightmare'),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_RESULT)),\n                )),\n                zones=(_bf,),\n            ),\n            'destination': _exile,\n        }),\n    )),\n)\nabilities = [harvest, *compiled]\n",
  "clauses": [
   {
    "clause": "{T}: Exile target creature card from a graveyard that was put there this turn.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "Create a token that's a copy of it, except it's a Nightmare in addition to its other types.",
    "ir": "abilities[0].effect.steps[1]"
   },
   {
    "clause": "Then exile all other Nightmare tokens you control.",
    "ir": "abilities[0].effect.steps[2]"
   }
  ],
  "g0_warnings": [],
  "notes": "Copy round B3 (DESIGN_ATOM_ONTOLOGY §18): 'that was put there this turn' is SUBJECT_OF_EVENT_THIS_TURN of a zone change into a graveyard (the card as the object it is now, CR 400.7); 'a copy of it, except it's a Nightmare' is CREATE_TOKEN(CopyOf(result, subtypes=(Nightmare,))) (CR 707.9b); 'all other Nightmare tokens you control' excludes the new token with FNot(IS_RESULT), the moved objects on MOVE_ZONE's cards role. Packs: tools/scenarios/mapped/FDN/abyssal_harvester_*.json."
 },

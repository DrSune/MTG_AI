  "draft_py": "# FDN Dwynen, Gilt-Leaf Daen: \"Reach. Other Elf creatures you control get +1/+1. Whenever Dwynen\n# attacks, you gain 1 life for each attacking Elf you control.\"\n# [0]: M21 Pack Leader's verified \"Other Dogs you control get +1/+1.\" with Elf.\n# [1]: Library Larcenist's \"Whenever this creature attacks\"; effect: M21 Aven Gagglemaster's verified\n# \"you gain 2 life for each creature you control with flying\" at 1, counting your attacking Elves\n# (IS_ATTACKING, Warded Battlements; Dwynen is one and counts itself). Reach is compiled.\nanthem = StaticAbility(\n    effect=A(Verb.MODIFY_PT, {\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n        'target': Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elf'),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n    }),\n)\nattacks = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=A(Verb.GAIN_LIFE, {\n        'amount': QBin(\n            op=QBinOp.MUL,\n            left=QConst(value=1),\n            right=QCount(\n                selector=Selector(\n                    count=QUnbounded(),\n                    mode=SelectorMode.ALL,\n                    filter=FAnd(\n                        children=(\n                            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                            FAtom(pred=FAtomPred.IS_ATTACKING),\n                            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Elf'),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                        ),\n                    ),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            ),\n        ),\n        'controller': ControllerRef.YOU,\n    }),\n)\nabilities = [anthem, attacks, *compiled]\n",
  "clauses": [
   {
    "clause": "Reach (This creature can block creatures with flying.)",

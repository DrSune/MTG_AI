  "draft_py": "# \"At the beginning of the end step, sacrifice this creature.\" — each end step (no actor), like\n# Liliana's Scrounger's \"At the beginning of each end step\"; \"this creature\" is the IS_SOURCE pick.\nend_step_sacrifice = TriggeredAbility(\n    event=TurnPhaseEvent(phase=Phase.END_TURN),\n    condition=None,\n    effect=A(Verb.SACRIFICE, {\n        'target': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.CHOOSE,\n            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n)\nabilities = [end_step_sacrifice, *compiled]\n",

  "draft_py": "SELF = Selector(\n    count=QConst(value=1), mode=SelectorMode.CHOOSE, filter=FAtom(pred=FAtomPred.IS_SOURCE),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))\n# {1}, {T}, Sacrifice a creature: Draw a card and put a soul counter on this artifact.\n# Activate only as a sorcery.\nfeed = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaGeneric(amount=QConst(value=1)),\n        CostTap(),\n        CostSacrifice(target=Selector(\n            count=QConst(value=1), mode=SelectorMode.CHOOSE,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))),\n    )),\n    effect=Seq(steps=(\n        A(Verb.DRAW, {'amount': QConst(value=1), 'controller': ControllerRef.YOU}),\n        A(Verb.PUT_COUNTER, {'count': QConst(value=1), 'counter_kind': CounterKind.SOUL, 'target': SELF}),\n    )),\n    timing=ActivationWindow.SORCERY,\n)\n# {4}, {T}, Sacrifice this artifact: Each opponent loses life equal to the number of soul counters on\n# this artifact.  (M21 Malefic Scythe's QProp('source', COUNTER_COUNT); soul is the only kind that\n# goes on it)\nrelease = ActivatedAbility(\n    cost=Cost(parts=(CostManaGeneric(amount=QConst(value=4)), CostTap(), CostSacrifice(target=SELF))),\n    effect=A(Verb.LOSE_LIFE, {\n        'amount': QProp(referent='source', field=QPropField.COUNTER_COUNT),\n        'controller': ControllerRef.ALL_OPPONENTS,\n    }),\n)\nabilities = [feed, release, *compiled]\n",

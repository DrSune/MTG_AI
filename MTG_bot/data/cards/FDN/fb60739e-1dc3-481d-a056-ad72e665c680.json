  "draft_py": "# FDN Rite of Replication (copy round B3, DESIGN_ATOM_ONTOLOGY §18)\n# compiled = [KickerAbility(Kicker {5}), SpellAbility(SORCERY, CREATE_TOKEN(copy of target creature))]\nkicker, spell = compiled\ncopy = spell.effect.args.get('tokens')  # B20-copy-token's CopyOf of \"target creature\"\n# \"If this spell was kicked, create five of those tokens instead.\" (B6's kicker \"instead\" form)\nabilities = [\n    kicker,\n    SpellAbility(\n        kind=SpellKind.SORCERY,\n        effect=Conditional(\n            pred=FAtom(pred=FAtomPred.WAS_KICKED),\n            then_effect=A(Verb.CREATE_TOKEN, {'count': QConst(value=5), 'tokens': copy}),\n            else_effect=spell.effect,\n        ),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Kicker {5}",
    "ir": "abilities[0]"
   },
   {
    "clause": "Create a token that's a copy of target creature.",
    "ir": "abilities[1].effect.else_effect"
   },
   {
    "clause": "If this spell was kicked, create five of those tokens instead.",
    "ir": "abilities[1].effect"
   }

  "draft_py": "# FDN Vampire Soulcaller: \"When this creature enters, return target creature card from your\n# graveyard to your hand.\"  Event: the compiler's \"When this creature enters\"; move: ZNR Bala Ged\n# Recovery's B5b-return-cards-hand with M21 Rise Again's creature filter.\nregrow = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=A(Verb.MOVE_ZONE, {\n        'cards': Selector(\n            count=QConst(value=1),\n            mode=SelectorMode.TARGET,\n            filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            zones=(Zone(kind=ZoneKind.GRAVEYARD, controller=ControllerRef.YOU),),\n        ),\n        'destination': Zone(kind=ZoneKind.HAND, controller=ControllerRef.YOU),\n    }),\n)\n# compiled: [0] the \"can't block\" static, [1] the creature carrier\nabilities = [compiled[0], regrow, compiled[1]]\n",
  "clauses": [
   {
    "clause": "Flying",
    "ir": "keywords[0]"
   },
   {
    "clause": "This creature can't block.",
    "ir": "abilities[0]"
   },
   {
    "clause": "When this creature enters, return target creature card from your graveyard to your hand.",
    "ir": "abilities[1]"
   }
  ],
  "g0_warnings": [],
  "notes": "ETB trigger with Bala Ged Recovery's return to hand over creature cards in your graveyard; the compiled 'can't block' static kept, in printed order."
 },

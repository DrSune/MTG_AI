 "mapping": {
  "author": "m8-mapper-opus",
  "date": "2026-11-17",
  "draft_py": "# {T}: Create X 1/1 red Goblin creature tokens, where X is the number of Goblins you control.\n# \"Goblins you control\" is the tribal noun (SUBTYPE_EQ + TYPE_EQ Creature), counted as the\n# ability resolves (M21 Rin and Seri's \"the number of Cats you control\").\ngoblins_you_control = Selector(\n    count=QUnbounded(), mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Goblin'),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))\nmob = ActivatedAbility(\n    cost=Cost(parts=(CostTap(),)),\n    effect=A(Verb.CREATE_TOKEN, {\n        'count': QCount(selector=goblins_you_control),\n        'tokens': TokenSpec(\n            name='Goblin', type_line='Creature — Goblin', types=('Creature',), subtypes=('Goblin',),\n            power=QConst(value=1), toughness=QConst(value=1), keywords=(), abilities=(), colors=('R',)),\n    }),\n)\nabilities = [mob, *compiled]\n",
  "clauses": [

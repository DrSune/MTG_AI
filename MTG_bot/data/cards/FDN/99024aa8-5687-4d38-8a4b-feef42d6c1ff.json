 "mapping": {
  "author": "claude-mapper-B",
  "date": "2026-10-29",
  "draft_py": "# Death Baron: \"Skeletons you control and other Zombies you control get +1/+1 and have deathtouch.\"\n# One filter (a creature that is both a Skeleton and a Zombie is affected once):\n#   creature you control AND (Skeleton OR (Zombie AND not this creature))\naffected = FAnd(children=(\n    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    FOr(children=(\n        FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Skeleton'),\n        FAnd(children=(\n            FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Zombie'),\n            FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n        )),\n    )),\n))\ndef sel():\n    return Selector(\n        count=QUnbounded(),\n        mode=SelectorMode.ALL,\n        filter=affected,\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    )\nlord = StaticAbility(effect=Seq(steps=(\n    A(Verb.MODIFY_PT, {\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n        'target': sel(),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n    }),\n    A(Verb.GRANT_ABILITY, {\n        'ability': KeywordAbility(keyword=Keyword.DEATHTOUCH),\n        'target': sel(),\n    }),\n)))\nabilities = [lord, *compiled]\n",
  "clauses": [
   {
    "clause": "Skeletons you control and other Zombies you control get +1/+1 and have deathtouch.",
    "ir": "abilities[0]"
   }
  ],

  "draft_py": "# You may play an additional land on each of your turns.  (M21 Azusa's verified form, one land)\nextra_land = StaticAbility(effect=OptionalEffect(inner=A(Verb.ADD_LAND_PLAY, {'count': QConst(value=1)})))\n# {4}{G}{G}, {T}: Look at the top six cards of your library. You may reveal a creature card with mana\n# value less than or equal to the number of lands you control from among them and put it onto the\n# battlefield. Put the rest on the bottom in a random order.  (Garruk's Harbinger's form; CMC_LE takes\n# a dynamic threshold, the lands you control counted as the ability resolves)\nTOP = (Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU, position=ZonePosition.TOP),)\nlands_you_control = QCount(selector=Selector(\n    count=QUnbounded(), mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),)))\ndig = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaColor(color='G', amount=QConst(value=1)),\n        CostManaColor(color='G', amount=QConst(value=1)),\n        CostManaGeneric(amount=QConst(value=4)),\n        CostTap(),\n    )),\n    effect=Seq(steps=(\n        A(Verb.LOOK_AT, {'controller': ControllerRef.YOU, 'count': QConst(value=6)}),\n        OptionalEffect(inner=Seq(steps=(\n            A(Verb.REVEAL, {'controller': ControllerRef.YOU, 'count': QConst(value=1)}),\n            A(Verb.MOVE_ZONE, {\n                'cards': Selector(\n                    count=QConst(value=1), mode=SelectorMode.ONE_OF,\n                    filter=FAnd(children=(\n                        FAtom(pred=FAtomPred.CMC_LE, count=lands_you_control),\n                        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    )),\n                    zones=TOP),\n                'destination': Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n            }),\n        ))),\n        A(Verb.MOVE_ZONE, {\n            'arrange': 'RANDOM',\n            'cards': Selector(count=QConst(value=1), mode=SelectorMode.REST, filter=FAnd(children=()), zones=TOP),\n            'destination': Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU, position=ZonePosition.BOTTOM),\n        }),\n    )),\n)\nabilities = [extra_land, dig, *compiled]\n",

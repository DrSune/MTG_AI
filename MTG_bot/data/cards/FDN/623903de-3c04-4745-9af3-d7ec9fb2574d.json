  "author": "claude-mapper-fdn-m1",
  "date": "2026-11-17",
  "draft_py": "# Bite Down (FDN): \"Target creature you control deals damage equal to its power to target creature\n# or planeswalker you don't control.\"\n# Shape: M21 Garruk, Savage Herald's -2 (B5c-loyalty-dmg-power): DEAL_DAMAGE whose `dealer` and\n# QProp POWER referent are the same TARGET selector (one slot), the second slot the recipient.\n# Recipient filter: \"creature or planeswalker\" (Scorching Dragonfire's FOr) and \"you don't control\"\n# (Hunter's Edge's FNot CONTROLLER_IS YOU).\nmine = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=A(Verb.DEAL_DAMAGE, {\n            'amount': QProp(referent=mine, field=QPropField.POWER),\n            'dealer': mine,\n            'target': Selector(\n                count=QConst(value=1),\n                mode=SelectorMode.TARGET,\n                filter=FAnd(\n                    children=(\n                        FOr(\n                            children=(\n                                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n                            ),\n                        ),\n                        FNot(inner=FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU)),\n                    ),\n                ),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n            ),\n        }),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Target creature you control deals damage equal to its power to target creature or planeswalker you don't control.",
    "ir": "abilities[0].effect (DEAL_DAMAGE: dealer and POWER referent = the first TARGET slot; target = the second)"
   }
  ],
  "g0_warnings": [],
  "notes": "M21 Garruk, Savage Herald's -2 shape: DEAL_DAMAGE with dealer and POWER referent the same TARGET slot (creature you control), recipient creature or planeswalker you don't control. packs in tools/scenarios/mapped/FDN/: bite_down_hits_a_planeswalker_you_dont_control, bite_down_no_damage_once_the_biter_is_gone, bite_down_the_creature_is_the_source (deathtouch and lifelink of the biter)."
 },

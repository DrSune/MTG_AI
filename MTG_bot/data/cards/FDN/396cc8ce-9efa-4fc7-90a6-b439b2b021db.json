  "draft_py": "_tgt = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nattack_trigger = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAnd(children=(\n        FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    ))),\n    condition=None,\n    effect=Seq(steps=(\n        A(Verb.MODIFY_PT, {\n            'duration': DurationEot(),\n            'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n            'target': _tgt,\n            'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n        }),\n        A(Verb.GRANT_ABILITY, {\n            'ability': KeywordAbility(keyword=Keyword.MENACE),\n            'duration': DurationEot(),\n            'target': _tgt,\n        }),\n    )),\n)\nabilities = [attack_trigger, *compiled]\n",

  "draft_py": "# Seize the Spoils: \"As an additional cost to cast this spell, discard a card. Draw two cards and\n# create a Treasure token.\"\n# The compiler's SpellAbility keeps its additional cost (CostDiscard, B5a-addl-cost-discard) and\n# gets the effect: DRAW 2 of you, then CREATE_TOKEN of one Treasure (the corpus' spec, M21 Gadrak;\n# FDN Gleaming Barrier). The compiled card keyword TREASURE (MTGJSON) is kept.\ntreasure = TokenSpec(\n    name='Treasure',\n    type_line='Artifact',\n    types=('Artifact',),\n    subtypes=(),\n    power=None,\n    toughness=None,\n    keywords=(Keyword.TREASURE,),\n    abilities=(\n        ActivatedAbility(\n            cost=Cost(parts=(\n                CostSacrifice(target=Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAtom(pred=FAtomPred.IS_SOURCE),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                )),\n                CostTap(),\n            )),\n            effect=A(Verb.ADD_MANA, {'amount': QConst(value=1), 'color': 'ANY', 'controller': ControllerRef.YOU}),\n        ),\n    ),\n)\ncarrier = compiled[0]\nabilities = [\n    SpellAbility(\n        kind=SpellKind.SORCERY,\n        additional_costs=carrier.additional_costs,\n        effect=Seq(steps=(\n            A(Verb.DRAW, {'amount': QConst(value=2), 'controller': ControllerRef.YOU}),\n            A(Verb.CREATE_TOKEN, {'count': QConst(value=1), 'tokens': treasure}),\n        )),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "As an additional cost to cast this spell, discard a card.",

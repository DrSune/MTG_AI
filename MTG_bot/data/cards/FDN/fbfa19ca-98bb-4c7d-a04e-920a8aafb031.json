 "mapping": {
  "author": "claude-mapper-M2",
  "date": "2026-11-17",
  "draft_py": "# Felling Blow: \"Put a +1/+1 counter on target creature you control. Then that creature deals damage\n# equal to its power to target creature an opponent controls.\"\n# M21 Hunter's Edge (verified, the same two sentences with \"you don't control\"): the compiler's\n# PUT_COUNTER is kept; the second sentence is Hunter's Edge's DEAL_DAMAGE (dealer and amount the\n# result register, the creature the counter went on) with the target filter \"creature an opponent\n# controls\" (B11-destroy-np's FAnd(CONTROLLER_IS OPPONENT, TYPE_EQ Creature)).\ncounter = compiled[0].effect\ndamage = A(Verb.DEAL_DAMAGE, {\n    'amount': QProp(referent='result', field=QPropField.POWER),\n    'dealer': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.CHOOSE,\n        filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n        referent='result',\n    ),\n    'target': Selector(\n        count=QConst(value=1),\n        mode=SelectorMode.TARGET,\n        filter=FAnd(children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.OPPONENT),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n        )),\n        zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n    ),\n})\nabilities = [SpellAbility(kind=SpellKind.SORCERY, effect=Seq(steps=(counter, damage)))]\n",
  "clauses": [
   {
    "clause": "Put a +1/+1 counter on target creature you control.",
    "ir": "abilities[0].effect.steps[0]"
   },
   {
    "clause": "Then that creature deals damage equal to its power to target creature an opponent controls.",
    "ir": "abilities[0].effect.steps[1]"
   }
  ],
  "g0_warnings": [],
  "notes": "M21 Hunter's Edge (verified) with the second target 'creature an opponent controls' (FAnd(CONTROLLER_IS OPPONENT, TYPE_EQ Creature)); the compiler's PUT_COUNTER is kept."
 },

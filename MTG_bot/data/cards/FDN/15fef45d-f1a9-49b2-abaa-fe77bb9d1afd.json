  "draft_py": "# Whenever another nontoken Dragon you control enters, create a 5/5 red Dragon creature token with\n# flying.  (FDN Arahbo's \"another nontoken Cat you control enters\" subject)\nanother_nontoken_dragon = FAnd(children=(\n    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n    FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Dragon'),\n    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n    FNot(inner=FAtom(pred=FAtomPred.IS_TOKEN)),\n))\ndragon_enters = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=another_nontoken_dragon),\n    condition=None,\n    effect=A(Verb.CREATE_TOKEN, {\n        'count': QConst(value=1),\n        'tokens': TokenSpec(\n            name='Dragon', type_line='Creature — Dragon', types=('Creature',), subtypes=('Dragon',),\n            power=QConst(value=5), toughness=QConst(value=5), keywords=(Keyword.FLYING,),\n            abilities=(), colors=('R',)),\n    }),\n)\n# {1}{R}: Dragons you control get +1/+0 until end of turn.  (Burn Bright's form, Dragons only)\nfirebreathing = ActivatedAbility(\n    cost=Cost(parts=(CostManaColor(color='R', amount=QConst(value=1)), CostManaGeneric(amount=QConst(value=1)))),\n    effect=A(Verb.MODIFY_PT, {\n        'duration': DurationEot(),\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=1)),\n        'target': Selector(\n            count=QUnbounded(), mode=SelectorMode.ALL,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.SUBTYPE_EQ, string_value='Dragon'),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),)),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=0)),\n    }),\n)\nabilities = [dragon_enters, firebreathing, *compiled]\n",

  "draft_py": "# {8}: Target creature gets +5/+5 and gains trample until end of turn.\n# (M21 Garruk, Unleashed's +1 and Sure Strike: one target selector shared by both atoms)\nT = Selector(\n    count=QConst(value=1), mode=SelectorMode.TARGET,\n    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))\npump = ActivatedAbility(\n    cost=Cost(parts=(CostManaGeneric(amount=QConst(value=8)),)),\n    effect=Seq(steps=(\n        A(Verb.MODIFY_PT, {\n            'duration': DurationEot(),\n            'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=5)),\n            'target': T,\n            'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=5)),\n        }),\n        A(Verb.GRANT_ABILITY, {\n            'ability': KeywordAbility(keyword=Keyword.TRAMPLE),\n            'duration': DurationEot(),\n            'target': T,\n        }),\n    )),\n)\nabilities = [pump, *compiled]\n",

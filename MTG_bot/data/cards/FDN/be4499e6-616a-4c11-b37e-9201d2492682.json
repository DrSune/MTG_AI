 "mapping": {
  "author": "claude-mapper-M2",
  "date": "2026-11-17",
  "draft_py": "# Offer Immortality: \"Target creature gains deathtouch and indestructible until end of turn.\"\n# Two GRANT_ABILITY atoms in printed keyword order (M21 Heroic Intervention's \"gain hexproof and\n# indestructible\" shape), each until end of turn, over one target creature: the same TARGET\n# selector in both, one target slot (M21 Sure Strike's \"gets +3/+0 and gains first strike\").\ntarget = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Seq(steps=(\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.DEATHTOUCH),\n                'duration': DurationEot(),\n                'target': target,\n            }),\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.INDESTRUCTIBLE),\n                'duration': DurationEot(),\n                'target': target,\n            }),\n        )),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Target creature gains deathtouch and indestructible until end of turn.",
    "ir": "abilities[0].effect.steps[0], abilities[0].effect.steps[1]"
   }
  ],
  "g0_warnings": [],
  "notes": "Two GRANT_ABILITY (DEATHTOUCH, INDESTRUCTIBLE) until end of turn in printed order (Heroic Intervention's two-keyword shape) over one TARGET selector, one slot (Sure Strike)."
 },

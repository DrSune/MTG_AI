  "draft_py": "# An Offer You Can't Refuse (FDN): \"Counter target noncreature spell. Its controller creates two\n# Treasure tokens.\"\n# Sentence 1: compiled (B9-counter-noncreature-spell), kept.\n# Sentence 2: M21 Secure the Scene's B5b-its-controller-token (CREATE_TOKEN `controller` = the\n# referent Selector over the target), count 2, with M21 Gadrak's verified Treasure TokenSpec,\n# byte for byte.\ntreasure = TokenSpec(\n    name='Treasure',\n    type_line='Artifact',\n    types=('Artifact',),\n    subtypes=(),\n    power=None,\n    toughness=None,\n    keywords=(Keyword.TREASURE,),\n    abilities=(\n        ActivatedAbility(\n            cost=Cost(\n                parts=(\n                    CostSacrifice(\n                        target=Selector(\n                            count=QConst(value=1),\n                            mode=SelectorMode.CHOOSE,\n                            filter=FAtom(pred=FAtomPred.IS_SOURCE),\n                            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                        ),\n                    ),\n                    CostTap(),\n                ),\n            ),\n            effect=A(Verb.ADD_MANA, {\n                'amount': QConst(value=1),\n                'color': 'ANY',\n                'controller': ControllerRef.YOU,\n            }),\n        ),\n    ),\n)\nits_controller = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.CHOOSE,\n    filter=FAnd(children=()),\n    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n    referent='target',\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Seq(\n            steps=(\n                compiled[0].effect,\n                A(Verb.CREATE_TOKEN, {\n                    'controller': its_controller,\n                    'count': QConst(value=2),\n                    'tokens': treasure,\n                }),\n            ),\n        ),\n    ),\n]\n",

  "draft_py": "# FDN Eager Trufflesnout: \"Trample. Whenever this creature deals combat damage to a player, create a\n# Food token.\"\n# Event: M21 Jeskai Elder's verified combat-damage-to-a-player trigger; effect: the one Food\n# (MAPPER_GUIDE R_FOOD, templates.food_token()), mandatory. Trample is compiled.\n# R_FOOD\nFOOD = TokenSpec(\n    name='Food', type_line='Artifact — Food', types=('Artifact',), subtypes=('Food',),\n    power=None, toughness=None, keywords=(),\n    abilities=(ActivatedAbility(\n        cost=Cost(parts=(CostManaGeneric(amount=QConst(value=2)), CostTap(), CostSacrifice(\n            target=Selector(\n                count=QConst(value=1), mode=SelectorMode.CHOOSE,\n                filter=FAtom(pred=FAtomPred.IS_SOURCE),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))))),\n        effect=A(Verb.GAIN_LIFE, {'amount': QConst(value=3), 'controller': ControllerRef.YOU})),),\n)\ncreate_food = A(Verb.CREATE_TOKEN, {'count': QConst(value=1), 'tokens': FOOD})\ntrigger = TriggeredAbility(\n    event=DamageDealtEvent(\n        amount=QUnbounded(),\n        filter=FNot(inner=FAtom(pred=FAtomPred.IS_PERMANENT)),\n        source=FAtom(pred=FAtomPred.IS_SOURCE),\n        combat=True,\n    ),\n    condition=None,\n    effect=create_food,\n)\nabilities = [trigger, *compiled]\n",
  "clauses": [

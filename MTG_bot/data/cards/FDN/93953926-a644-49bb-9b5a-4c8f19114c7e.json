  "draft_py": "SELF = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.CHOOSE,\n    filter=FAtom(pred=FAtomPred.IS_SOURCE),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\n\n\ndef basic_land_search():\n    \"\"\"search their/your library for a basic land card, put it onto the battlefield, then shuffle\n    (YOU-relative: an EachPlayer rotates it to that land's controller).\"\"\"\n    return Seq(\n        steps=(\n            A(Verb.SEARCH, {\n                'cards': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.CHOOSE,\n                    filter=FAnd(\n                        children=(\n                            FAtom(pred=FAtomPred.SUPERTYPE_EQ, string_value='Basic'),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n                        ),\n                    ),\n                    zones=(Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU),),\n                ),\n                'destination': Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n            }),\n            A(Verb.SHUFFLE, {'zone': Zone(kind=ZoneKind.LIBRARY, controller=ControllerRef.YOU)}),\n        ),\n    )\n\n\nTHAT_LANDS_CONTROLLER = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.CHOOSE,\n    filter=FAnd(children=()),\n    zones=(Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),),\n    referent='target',\n)\ndemolish = ActivatedAbility(\n    cost=Cost(parts=(CostManaGeneric(amount=QConst(value=2)), CostTap(), CostSacrifice(target=SELF))),\n    effect=Seq(\n        steps=(\n            A(Verb.DESTROY, {\n                'target': Selector(\n                    count=QConst(value=1),\n                    mode=SelectorMode.TARGET,\n                    filter=FAnd(\n                        children=(\n                            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.OPPONENT),\n                            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Land'),\n                            FNot(inner=FAtom(pred=FAtomPred.SUPERTYPE_EQ, string_value='Basic')),\n                        ),\n                    ),\n                    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n                ),\n            }),\n            EachPlayer(ref=THAT_LANDS_CONTROLLER, effect=OptionalEffect(inner=basic_land_search())),\n            OptionalEffect(inner=basic_land_search()),\n        ),\n    ),\n)\n# compiled: [0] {T}: Add {C}.\nabilities = [compiled[0], demolish]\n",

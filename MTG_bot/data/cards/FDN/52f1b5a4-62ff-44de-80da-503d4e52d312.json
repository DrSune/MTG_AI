  "draft_py": "# FDN Cat Collector: \"When this creature enters, create a Food token. (It's an artifact with\n# \"{2}, {T}, Sacrifice this token: You gain 3 life.\") Whenever you gain life for the first time\n# during each of your turns, create a 1/1 white Cat creature token.\"\n# Enters: the compiler's \"When this creature enters\" with the one Food of the ruling R_FOOD\n# (MAPPER_GUIDE, templates.food_token(), copied exactly). compiled[0] is the compiler's lifegain\n# trigger (LifeGainedEvent, actor you during your turn, ordinal 1: MAPPER_GUIDE's \"for the first\n# time during each of your turns\"), kept; compiled[1] the creature's cast carrier.\n# R_FOOD\nFOOD = TokenSpec(\n    name='Food', type_line='Artifact — Food', types=('Artifact',), subtypes=('Food',),\n    power=None, toughness=None, keywords=(),\n    abilities=(ActivatedAbility(\n        cost=Cost(parts=(CostManaGeneric(amount=QConst(value=2)), CostTap(), CostSacrifice(\n            target=Selector(\n                count=QConst(value=1), mode=SelectorMode.CHOOSE,\n                filter=FAtom(pred=FAtomPred.IS_SOURCE),\n                zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))))),\n        effect=A(Verb.GAIN_LIFE, {'amount': QConst(value=3), 'controller': ControllerRef.YOU})),),\n)\ncreate_food = A(Verb.CREATE_TOKEN, {'count': QConst(value=1), 'tokens': FOOD})\netb = TriggeredAbility(\n    event=ZoneChangeEvent(\n        from_zone=Zone(kind=ZoneKind.ANY, controller=ControllerRef.ANY),\n        to_zone=Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.YOU),\n        subject=FAtom(pred=FAtomPred.IS_SOURCE),\n    ),\n    condition=None,\n    effect=create_food,\n)\nabilities = [etb, *compiled]\n",
  "clauses": [
   {
    "clause": "When this creature enters, create a Food token.",
    "ir": "abilities[0] (CREATE_TOKEN one Food, the R_FOOD TokenSpec)"
   },
   {
    "clause": "Whenever you gain life for the first time during each of your turns, create a 1/1 white Cat creature token.",
    "ir": "abilities[1] (the compiler's: LifeGainedEvent you, your turn, ordinal 1; one 1/1 white Cat)"
   }
  ],

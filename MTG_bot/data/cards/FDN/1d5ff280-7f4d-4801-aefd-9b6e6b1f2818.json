  "draft_py": "T = Selector(\n    count=QConst(value=1), mode=SelectorMode.TARGET,\n    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),))\n# [−3]: Target creature gains flying and double strike until end of turn.\n# Two grants to one target (Sure Strike / Garruk, Unleashed share the selector), sorted by name (D23).\nminus_three = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=-3),)),\n    effect=Seq(steps=(\n        A(Verb.GRANT_ABILITY, {\n            'ability': KeywordAbility(keyword=Keyword.DOUBLE_STRIKE),\n            'duration': DurationEot(),\n            'target': T,\n        }),\n        A(Verb.GRANT_ABILITY, {\n            'ability': KeywordAbility(keyword=Keyword.FLYING),\n            'duration': DurationEot(),\n            'target': T,\n        }),\n    )),\n)\n# [−8]: Create X 2/2 white Cat creature tokens, where X is your life total.\nminus_eight = ActivatedAbility(\n    cost=Cost(parts=(CostLoyalty(delta=-8),)),\n    effect=A(Verb.CREATE_TOKEN, {\n        'count': QProp(referent='controller', field=QPropField.LIFE),\n        'tokens': TokenSpec(\n            name='Cat', type_line='Creature — Cat', types=('Creature',), subtypes=('Cat',),\n            power=QConst(value=2), toughness=QConst(value=2), keywords=(), abilities=(), colors=('W',)),\n    }),\n)\n# compiled[0]: [+1]: Put a +1/+1 counter on up to one target creature.  compiled[1]: the carrier.\nabilities = [compiled[0], minus_three, minus_eight, compiled[1]]\n",

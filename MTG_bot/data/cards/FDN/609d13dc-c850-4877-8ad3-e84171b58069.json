  "draft_py": "# {3}{W}{W}: Attacking creatures you control get +X/+X until end of turn, where X is the number of\n# attacking creatures.  X counts every attacking creature (M21 Alpine Houndmaster's count, without\n# its \"other\"), read as the ability resolves; the affected set is your attacking creatures then.\nX = QCount(selector=Selector(\n    count=QUnbounded(), mode=SelectorMode.ALL,\n    filter=FAnd(children=(\n        FAtom(pred=FAtomPred.IS_ATTACKING),\n        FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    )),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),)))\nrally = ActivatedAbility(\n    cost=Cost(parts=(\n        CostManaColor(color='W', amount=QConst(value=1)),\n        CostManaColor(color='W', amount=QConst(value=1)),\n        CostManaGeneric(amount=QConst(value=3)),\n    )),\n    effect=A(Verb.MODIFY_PT, {\n        'duration': DurationEot(),\n        'power': PtDelta(direction=PtDirection.INCREASE, magnitude=X),\n        'target': Selector(\n            count=QUnbounded(), mode=SelectorMode.ALL,\n            filter=FAnd(children=(\n                FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                FAtom(pred=FAtomPred.IS_ATTACKING),\n                FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            )),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),)),\n        'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=X),\n    }),\n)\nabilities = [rally, *compiled]\n",

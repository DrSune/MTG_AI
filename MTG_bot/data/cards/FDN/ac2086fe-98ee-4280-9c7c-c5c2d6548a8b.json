  "draft_py": "# Burst Lightning (FDN). Kicker {4} (compiled KickerAbility, kept).\n# \"Burst Lightning deals 2 damage to any target.\" (compiled, kept as the else branch)\n# \"If this spell was kicked, it deals 4 damage instead.\" -- ZNR Roil Eruption's\n# B6-kicker-instead-suffix: Conditional(WAS_KICKED, the damage at 4, else the printed 2).\nany_target = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FOr(\n        children=(\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Planeswalker'),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Player'),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    compiled[0],\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Conditional(\n            pred=FAtom(pred=FAtomPred.WAS_KICKED),\n            then_effect=A(Verb.DEAL_DAMAGE, {'amount': QConst(value=4), 'target': any_target}),\n            else_effect=compiled[1].effect,\n        ),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Kicker {4} (You may pay an additional {4} as you cast this spell.)",
    "ir": "abilities[0] (compiled KickerAbility)"
   },
   {
    "clause": "Burst Lightning deals 2 damage to any target.",
    "ir": "abilities[1].effect.else_effect (compiled)"
   },
   {
    "clause": "If this spell was kicked, it deals 4 damage instead.",
    "ir": "abilities[1].effect (Conditional WAS_KICKED; then_effect deals 4)"
   }
  ],
  "g0_warnings": [
   "MTGJSON keywords with no Keyword atom (check how the tree expresses them): ['KICKER']"

  "draft_py": "SELF = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.CHOOSE,\n    filter=FAtom(pred=FAtomPred.IS_SOURCE),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nYOUR_TURN = FAtom(pred=FAtomPred.TURN_OF, who=ControllerRef.YOU)\nself_first_strike = StaticAbility(\n    effect=A(Verb.GRANT_ABILITY, {\n        'ability': KeywordAbility(keyword=Keyword.FIRST_STRIKE),\n        'target': SELF,\n    }),\n    condition=YOUR_TURN,\n)\ncountered_first_strike = StaticAbility(\n    effect=A(Verb.GRANT_ABILITY, {\n        'ability': KeywordAbility(keyword=Keyword.FIRST_STRIKE),\n        'target': Selector(\n            count=QUnbounded(),\n            mode=SelectorMode.ALL,\n            filter=FAnd(\n                children=(\n                    FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n                    FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n                    FAtom(\n                        pred=FAtomPred.HAS_COUNTER,\n                        count=QConst(value=1),\n                        counter_kind=CounterKind.PLUS_1_PLUS_1,\n                    ),\n                ),\n            ),\n            zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n        ),\n    }),\n    condition=YOUR_TURN,\n)\nabilities = [self_first_strike, countered_first_strike, *compiled]\n",

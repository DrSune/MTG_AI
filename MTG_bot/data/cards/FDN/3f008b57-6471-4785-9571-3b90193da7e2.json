 "mapping": {
  "author": "claude-mapper-m4",
  "date": "2026-11-17",
  "draft_py": "# FDN Ashroot Animist: \"Whenever this creature attacks, another target creature you control gains\n# trample and gets +X/+X until end of turn, where X is this creature's power.\"\n# One TARGET slot read by both steps (Sure Strike's form), in printed order: M21 Crash Through's\n# trample grant and M21 Primal Might's +X/+X, X as M21 Conclave Mentor's QProp('source', POWER).\nOTHER = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAnd(\n        children=(\n            FAtom(pred=FAtomPred.CONTROLLER_IS, who=ControllerRef.YOU),\n            FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n            FNot(inner=FAtom(pred=FAtomPred.IS_SOURCE)),\n        ),\n    ),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nX = QProp(referent='source', field=QPropField.POWER)\nshare = TriggeredAbility(\n    event=DeclareAttackersEvent(filter=FAtom(pred=FAtomPred.IS_SOURCE)),\n    condition=None,\n    effect=Seq(\n        steps=(\n            A(Verb.GRANT_ABILITY, {\n                'ability': KeywordAbility(keyword=Keyword.TRAMPLE),\n                'duration': DurationEot(),\n                'target': OTHER,\n            }),\n            A(Verb.MODIFY_PT, {\n                'duration': DurationEot(),\n                'power': PtDelta(direction=PtDirection.INCREASE, magnitude=X),\n                'target': OTHER,\n                'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=X),\n            }),\n        ),\n    ),\n)\nabilities = [share, *compiled]\n",
  "clauses": [
   {
    "clause": "Trample",
    "ir": "keywords[0]"
   },
   {
    "clause": "Whenever this creature attacks, another target creature you control gains trample and gets +X/+X until end of turn, where X is this creature's power.",

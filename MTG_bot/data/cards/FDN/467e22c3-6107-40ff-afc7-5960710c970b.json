 "mapping": {
  "author": "claude-mapper-fdn-m1",
  "date": "2026-11-17",
  "draft_py": "# Adamant Will (FDN): \"Target creature gets +2/+2 and gains indestructible until end of turn.\"\n# Shape: M21 Sure Strike's B5b-seq-modpt-firststrike (one TARGET slot shared by the two steps),\n# with +2/+2 and Basri Ket's INDESTRUCTIBLE grant.\ncreature = Selector(\n    count=QConst(value=1),\n    mode=SelectorMode.TARGET,\n    filter=FAtom(pred=FAtomPred.TYPE_EQ, string_value='Creature'),\n    zones=(Zone(kind=ZoneKind.BATTLEFIELD, controller=ControllerRef.ANY),),\n)\nabilities = [\n    SpellAbility(\n        kind=SpellKind.INSTANT,\n        effect=Seq(\n            steps=(\n                A(Verb.MODIFY_PT, {\n                    'duration': DurationEot(),\n                    'power': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n                    'target': creature,\n                    'toughness': PtDelta(direction=PtDirection.INCREASE, magnitude=QConst(value=2)),\n                }),\n                A(Verb.GRANT_ABILITY, {\n                    'ability': KeywordAbility(keyword=Keyword.INDESTRUCTIBLE),\n                    'duration': DurationEot(),\n                    'target': creature,\n                }),\n            ),\n        ),\n    ),\n]\n",
  "clauses": [
   {
    "clause": "Target creature gets +2/+2 and gains indestructible until end of turn.",
    "ir": "abilities[0].effect (steps[0] MODIFY_PT +2/+2 EOT; steps[1] GRANT_ABILITY INDESTRUCTIBLE EOT; one TARGET slot)"
   }
  ],
  "g0_warnings": [],
  "notes": "M21 Sure Strike's pump-and-grant Seq (one TARGET slot) with +2/+2 and INDESTRUCTIBLE, both until end of turn."
 },
